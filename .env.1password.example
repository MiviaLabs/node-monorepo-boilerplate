# =============================================================================
# 1Password Integration Environment Variables
# =============================================================================
# This file shows the REQUIRED variables to enable 1Password integration
# for any deployment platform (Railway, Docker, Kubernetes, etc.).
# The actual secret values should be stored in 1Password.
#
# Setup: https://1password.com/docs/cli/secrets-environment-variables/
# =============================================================================

# =============================================================================
# 1PASSWORD INTEGRATION (Required for 1Password integration)
# =============================================================================

# Enable 1Password integration
# Set to "true" to fetch secrets from 1Password at runtime
# Set to "false" or omit to use platform environment variables only
OP_ENABLED=true

# 1Password Service Account Token
# Create at: 1Password -> Integrations -> Service Accounts
# Required: Read Items permission on the specified vault
# SECURITY: Store as platform secret/reference, not plain text!
OP_SERVICE_ACCOUNT_TOKEN=[PLATFORM_REFERENCE]

# 1Password Vault ID or Name
# The vault containing your runtime secrets
# Default: runtime-secrets
OP_VAULT_ID=runtime-secrets

# 1Password Item Name
# The Secure Note name containing your secrets as fields
# Default: Runtime Secrets
OP_ITEM_NAME=Runtime Secrets

# 1Password Field Name (optional, for text-based format)
# If your Secure Note uses text-based format (KEY=VALUE pairs in one field),
# specify the field name here. Default: "notes"
# OP_FIELD_NAME=notes

# =============================================================================
# OPTIONAL: Platform Fallback Variables
# =============================================================================
# These can be set directly in your platform (Railway, Docker Compose, etc.),
# but will be OVERRIDDEN by 1Password values if OP_ENABLED=true.
# Use these for testing or fallback.
#
# Recommended: Store these in 1Password Secure Note instead!
# =============================================================================

# Database
# DATABASE_URL=postgres://user:pass@host:5432/db

# JWT Configuration
# JWT_SECRET=your-jwt-secret-here
# JWT_EXPIRATION=1d

# Redis
# REDIS_URL=redis://host:6379

# External APIs
# API_KEY_EXTERNAL=your-external-api-key

# SMTP (if using email)
# SMTP_HOST=smtp.example.com
# SMTP_USER=noreply@example.com
# SMTP_PASS=your-smtp-password

# =============================================================================
# 1PASSWORD SECURE NOTE STRUCTURE
# =============================================================================
#
# This integration supports TWO formats for storing secrets in 1Password:
#
# ============================================================================
# FORMAT 1: Field-based (one field per environment variable)
# ============================================================================
#
# In 1Password, create a Secure Note with the following structure:
#
# Item Name: Runtime Secrets
# Category: Secure Note
#
# Fields (each field becomes an environment variable):
#   Label: DATABASE_URL          -> Value: postgres://...
#   Label: JWT_SECRET            -> Value: your-jwt-secret
#   Label: REDIS_URL             -> Value: redis://...
#   Label: API_KEY_EXTERNAL      -> Value: your-api-key
#   Label: SMTP_HOST             -> Value: smtp.example.com
#   Label: SMTP_USER             -> Value: noreply@example.com
#   Label: SMTP_PASS             -> Value: smtp-password
#
# IMPORTANT: The "Label" becomes the environment variable name!
#
# ============================================================================
# FORMAT 2: Text-based (KEY=VALUE pairs in a single field)
# ============================================================================
#
# In 1Password, create a Secure Note with:
#
# Item Name: Runtime Secrets
# Category: Secure Note
#
# Fields:
#   Label: notes                 -> Value: (paste your .env file content)
#   Label: env                   -> Value: (alternative field name)
#
# Field value example (what you paste into the field):
#   HOST=0.0.0.0
#   PORT=3000
#   NODE_ENV=production
#   API_PREFIX=api
#   DATABASE_URL=postgres://...
#   JWT_SECRET=your-secret
#   # Comments are supported
#   REDIS_URL=redis://...
#
# The script auto-detects which format you're using.
#
# =============================================================================

# =============================================================================
# TESTING 1PASSWORD INTEGRATION
# =============================================================================
# To test locally before deploying:
#
# 1. Install 1Password CLI: https://1password.com/downloads/cli/
# 2. Authenticate: op account add
# 3. Set environment variables:
#    export OP_ENABLED=true
#    export OP_SERVICE_ACCOUNT_TOKEN=your-token
#    export OP_VAULT_ID=your-vault
#    export OP_ITEM_NAME="Runtime Secrets"
# 4. Run: docker build -t test . && docker run -it test sh
# 5. Inside container: ./entrypoint.sh
#
# For Docker Compose, add to docker-compose.yml:
#   environment:
#     - OP_ENABLED=true
#     - OP_SERVICE_ACCOUNT_TOKEN=${OP_SERVICE_ACCOUNT_TOKEN}
#     - OP_VAULT_ID=${OP_VAULT_ID}
#     - OP_ITEM_NAME=${OP_ITEM_NAME}
#
# For Railway, add these variables in Railway -> Settings -> Variables
#
# For Kubernetes, use:
#   env:
#     - name: OP_ENABLED
#       value: "true"
#     - name: OP_SERVICE_ACCOUNT_TOKEN
#       valueFrom:
#         secretKeyRef:
#           name: op-token
#           key: token
# =============================================================================
