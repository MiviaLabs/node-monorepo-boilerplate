{
  "$schema": "https://typedoc.org/schema.json",
  "tsconfig": "./tsconfig.typedoc.json",
  "entryPoints": [
    "packages/auth/src/index.ts",
    "packages/constants/src/index.ts",
    "packages/core/src/index.ts",
    "packages/db-core/src/index.ts",
    "packages/db-outbox/src/index.ts",
    "packages/encryption/src/index.ts",
    "packages/errors/src/index.ts",
    "packages/events/src/index.ts",
    "packages/i18n/src/index.ts",
    "packages/observability/src/index.ts",
    "packages/opa/src/index.ts",
    "packages/pubsub/src/index.ts",
    "packages/queues/src/index.ts",
    "packages/redis/src/index.ts",
    "packages/schema/src/index.ts",
    "packages/secrets/src/index.ts",
    "packages/tasks/src/index.ts",
    "packages/test-utils/src/index.ts",
    "packages/types/src/index.ts",
    "packages/utils/src/index.ts"
  ],
  "out": ".agents/docs/reference/packages",
  "plugin": ["typedoc-plugin-markdown"],
  "outputFileStrategy": "modules",
  "entryPointStrategy": "expand",
  "exclude": ["**/*.spec.ts", "**/*.test.ts"],
  "excludePrivate": true,
  "excludeProtected": true,
  "readme": "none",
  "githubPages": false,
  "externalSymbolLinkMappings": {
    "@package/types": { "*": "types/src" },
    "@package/utils": { "*": "utils/src" },
    "@package/schema": { "*": "schema/src" },
    "@package/constants": { "*": "constants/src" },
    "@package/core": { "*": "core/src" },
    "@package/auth": { "*": "auth/src" },
    "@package/errors": { "*": "errors/src" },
    "@package/events": { "*": "events/src" },
    "@package/observability": { "*": "observability/src" },
    "@package/redis": { "*": "redis/src" },
    "@package/encryption": { "*": "encryption/src" },
    "@package/queues": { "*": "queues/src" },
    "@package/pubsub": { "*": "pubsub/src" },
    "@package/tasks": { "*": "tasks/src" },
    "@package/secrets": { "*": "secrets/src" },
    "@package/db-core": { "*": "db-core/src" },
    "@package/db-outbox": { "*": "db-outbox/src" },
    "@package/i18n": { "*": "i18n/src" }
  },
  "blockTags": [
    "@param",
    "@returns",
    "@throws",
    "@example",
    "@see",
    "@since",
    "@deprecated",
    "@default",
    "@minimum",
    "@maximum",
    "@description",
    "@security",
    "@warning",
    "@env",
    "@implements",
    "@fileoverview",
    "@decorator",
    "@Instrumented",
    "@Encrypted",
    "@Roles",
    "@RequirePermissions",
    "@HandleVersion",
    "@EventHandler",
    "@typeParam",
    "@remarks",
    "@template",
    "@category",
    "@module",
    "@packageDocumentation",
    "@property",
    "@extends",
    "@callback",
    "@type",
    "@typedef",
    "@enum",
    "@member",
    "@memberof",
    "@namespace",
    "@interface",
    "@class",
    "@constructor",
    "@function",
    "@method",
    "@abstract",
    "@override",
    "@readonly",
    "@async",
    "@generator",
    "@yields",
    "@fires",
    "@emits",
    "@listens",
    "@event",
    "@access",
    "@public",
    "@private",
    "@protected",
    "@internal",
    "@ignore",
    "@hideconstructor",
    "@alias",
    "@augments",
    "@mixes",
    "@requires",
    "@version",
    "@author",
    "@copyright",
    "@license",
    "@link",
    "@tutorial",
    "@variation",
    "@satisfies",
    "@defaultValue",
    "@experimental",
    "@beta",
    "@alpha",
    "@virtual",
    "@sealed",
    "@packageDescription"
  ]
}
