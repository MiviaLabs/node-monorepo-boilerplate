# =============================================================================
# Local Development Environment Variables
# =============================================================================
# This file contains all environment variables for local development.
# Copy this file to .env.local or .env and customize as needed.
#
# Usage:
#   cp .env.example .env.local
#   # Edit .env.local with your custom values
#
# Note: Values here are defaults for the docker-compose.dev.yml services
# =============================================================================

# =============================================================================
# DATABASE
# =============================================================================
# PostgreSQL database connection
DATABASE_URL=postgresql://starter:starter_dev@localhost:5432/starter_db
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# =============================================================================
# REDIS
# =============================================================================
# Redis cache connection
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# =============================================================================
# RABBITMQ
# =============================================================================
# RabbitMQ message queue connection
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# =============================================================================
# MINIO (S3-compatible storage)
# =============================================================================
# MinIO object storage for local development
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=node-monorepo-boilerplate-dev
S3_REGION=us-east-1
S3_USE_SSL=false

# Storage package variables (packages/storage)
STORAGE_INSTANCES=
STORAGE_DEFAULT_INSTANCE=default
STORAGE_PROVIDER=s3
STORAGE_DEFAULT_BUCKET=node-monorepo-boilerplate-dev
STORAGE_S3_ENDPOINT=http://localhost:9000
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ACCESS_KEY_ID=minioadmin
STORAGE_S3_SECRET_ACCESS_KEY=minioadmin
STORAGE_S3_SESSION_TOKEN=
STORAGE_S3_FORCE_PATH_STYLE=true
STORAGE_S3_BUCKET=
STORAGE_S3_PUBLIC_BASE_URL=
STORAGE_S3_SIGNED_URL_EXPIRES_IN_SECONDS=900
STORAGE_TEST_MODE=false

# Example named storage instance:
# STORAGE_INSTANCES=default,private
# STORAGE_PRIVATE_DEFAULT_BUCKET=node-monorepo-boilerplate-private
# STORAGE_PRIVATE_S3_ENDPOINT=http://localhost:9000
# STORAGE_PRIVATE_S3_REGION=us-east-1
# STORAGE_PRIVATE_S3_ACCESS_KEY_ID=minioadmin
# STORAGE_PRIVATE_S3_SECRET_ACCESS_KEY=minioadmin
# STORAGE_PRIVATE_S3_FORCE_PATH_STYLE=true
# STORAGE_PRIVATE_S3_BUCKET=
# STORAGE_PRIVATE_S3_PUBLIC_BASE_URL=
# STORAGE_PRIVATE_S3_SIGNED_URL_EXPIRES_IN_SECONDS=900
# STORAGE_PRIVATE_TEST_MODE=false

# =============================================================================
# EMAIL (Mailhog for local development)
# =============================================================================
# SMTP configuration for email testing
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@example.local

# =============================================================================
# APPLICATION
# =============================================================================
# Application configuration
NODE_ENV=development
LOG_LEVEL=debug
API_PORT=3000
WEB_PORT=3001

# =============================================================================
# OPA (Policy Authorization)
# =============================================================================
# Local OPA server started by docker-compose.dev.yml
OPA_URL=http://localhost:8181
# Policy endpoint for allow decisions
OPA_POLICY_PATH=/v1/data/authorization/allow
# OPA request timeout in milliseconds
OPA_TIMEOUT=5000
# Guard mode: off | shadow | hybrid | strict
OPA_ENFORCEMENT_MODE=hybrid

# =============================================================================
# SECURITY (development - do not use in production!)
# =============================================================================
# JWT authentication
JWT_SECRET=dev-secret-key-change-in-production
JWT_EXPIRATION=1d

# Encryption key for PII data (32+ characters)
ENCRYPTION_KEY=dev-encryption-key-32-chars-long!

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Feature flags for development
FEATURE_SIGNUPS_ENABLED=true
FEATURE_EMAIL_VERIFICATION_REQUIRED=false
FEATURE_MULTI_TENANCY_ENABLED=true

# =============================================================================
# 1PASSWORD INTEGRATION (Optional - for production deployments)
# =============================================================================
# See .env.1password.example for full details
# OP_ENABLED=false
# OP_SERVICE_ACCOUNT_TOKEN=
# OP_VAULT_ID=runtime-secrets
# OP_ITEM_NAME=Runtime Secrets

# =============================================================================
# OBSERVABILITY (Optional - for local development)
# =============================================================================
# OpenTelemetry configuration
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_SERVICE_NAME=node-monorepo-boilerplate-api
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local

# =============================================================================
# GCP / FIREBASE (Optional - for development)
# =============================================================================
# Google Cloud Platform configuration
# GCP_PROJECT_ID=your-project-id
# GCP_BUCKET_NAME=your-bucket-name
# FIREBASE_PROJECT_ID=your-firebase-project
# FIREBASE_PRIVATE_KEY=your-firebase-private-key
# FIREBASE_CLIENT_EMAIL=your-firebase-client-email

# =============================================================================
# GCP KMS (Cloud Key Management Service) - For Production Encryption
# =============================================================================
# Use GCP KMS for production encryption. For local development, use ENCRYPTION_KEY.
#
# ARCHITECTURE: Single Primary Key
# =================================
# This project uses ONE primary encryption key (primary-encryption-key) shared
# across all tenants. Tenant isolation is maintained via unique Data Encryption
# Keys (DEKs) per vault entry, not separate KEKs per tenant.
#
# Benefits:
# - Cost: $1/month (single key) vs $1M+/month (1M tenant-specific keys)
# - Simplicity: One key to manage, monitor, and rotate
# - Security: Tenant isolation via envelope encryption (DEKs)
#
# Production Configuration (must match Terraform outputs from .devops/terraform/gcp-kms):
# GCP_PROJECT_ID=your-gcp-project-id
# GCP_LOCATION_ID=global
# GCP_KEY_RING_ID=app-encryption-keys
# GCP_KEY_ID=primary-encryption-key
#
# Authentication:
# - Service account file: GCP_CREDENTIALS_FILE=/path/to/credentials.json
# - Base64-encoded JSON: GCP_CREDENTIALS_BASE64=base64-encoded-service-account-json
# - Application Default Credentials (ADC): gcloud auth application-default login

# =============================================================================
# EXTERNAL SERVICES (Optional)
# =============================================================================
# Stripe for payments (if using Stripe)
# STRIPE_SECRET_KEY=sk_test_your_key_here
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Sendgrid for email production (if not using Mailhog)
# SENDGRID_API_KEY=your_sendgrid_api_key
# SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# Resend for outbound email + inbound webhook verification
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_...
# RESEND_WEBHOOK_SECRET=whsec_...
