# Web Configuration
NODE_ENV=development
HOST=0.0.0.0
PORT=3001
# Note: Next.js automatically reads PORT and HOST environment variables

# Application Configuration
NEXT_PUBLIC_APP_NAME=MiviaLabs

# API Configuration
# ==============================================================================
# Architecture: Client -> /api/trpc (Next.js) -> /api/auth/* (Next.js API routes) -> Backend API
#
# API_URL (server-side):
#   - Used by Next.js API routes (server-side only) to call the backend
#   - Should point directly to backend API server (no /api prefix needed)
#   - For local dev: http://localhost:3000
#   - For Railway: Set this to your backend Railway URL (e.g., https://api-dev-dev-4cee.up.railway.app)
#   - If not set, server-side calls will fail
API_URL=http://localhost:3000
#
# NEXT_PUBLIC_API_URL (client-side) - DO NOT SET IN PRODUCTION
#   - WARNING: Setting this in production causes client to bypass Next.js API routes
#   - Only set this for local development when frontend and backend are on different origins
#   - For Railway deployment: Leave this UNSET to use relative URLs (/api/trpc)
#   - When unset, tRPC will use relative URLs which route through Next.js API routes
# NEXT_PUBLIC_API_URL=

# Redis for session storage (optional - fallback to cookies)
# ===============================================
# Redis connection URL for server-side session storage
# If not provided, sessions will use cookies as fallback
REDIS_URL=redis://localhost:6379

# Upstash Redis (for Edge runtime session caching)
# ===============================================
# Edge-compatible Redis client for session cache in middleware
# Required for production multi-replica deployments
# Get credentials from: https://console.upstash.com/
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here

# Session Configuration
# ================
# Session TTL in seconds (default: 604800 = 7 days)
SESSION_TTL=604800

# Session cookie name (default: sessionId)
SESSION_COOKIE_NAME=sessionId

# Session cookie settings
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SECURE=true  # Enable in production with HTTPS

# Application URLs
# ================
# Web application URL (for redirects, OAuth callbacks, etc.)
# For local dev: http://localhost:3001
# For Railway: Set to your frontend Railway URL (e.g., https://web-dev-dev-c346.up.railway.app)
# Railway provides RAILWAY_PUBLIC_URL automatically, but you can override with NEXT_PUBLIC_APP_URL
NEXT_PUBLIC_APP_URL=http://localhost:3001
