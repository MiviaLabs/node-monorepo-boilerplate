{
  "name": "api",
  "version": "0.0.1",
  "type": "commonjs",
  "scripts": {
    "test": "jest",
    "test:unit": "jest src",
    "test:unit:watch": "jest src --watch",
    "seed:system-user": "pnpm exec tsx scripts/seed-system-user.ts",
    "test:e2e": "pnpm build:packages && jest --config=jest.e2e.config.js \"test/e2e/**/*.e2e.spec.ts\" --detectOpenHandles --forceExit",
    "test:e2e:strict": "OPA_ENABLED=true OPA_ENFORCEMENT_MODE=strict pnpm test:e2e",
    "test:e2e:strict:smoke": "OPA_ENABLED=true OPA_ENFORCEMENT_MODE=strict pnpm build:packages && jest --config=jest.e2e.config.js test/e2e/opa-strict/opa-strict-smoke.e2e.spec.ts --runInBand",
    "test:e2e:legacy": "OPA_ENABLED=false OPA_ENFORCEMENT_MODE=off pnpm test:e2e",
    "test:e2e:watch": "jest --config=jest.e2e.config.js \"test/e2e/**/*.e2e.spec.ts\" --watch",
    "test:e2e:setup": "pnpm exec tsx test/global-test-db.ts start",
    "test:e2e:teardown": "pnpm exec tsx test/global-test-db.ts stop",
    "test:e2e:status": "pnpm exec tsx test/global-test-db.ts status",
    "test:e2e:manual": "pnpm exec tsx test/global-test-db.ts start-interactive",
    "test:all": "jest src test --detectOpenHandles --forceExit",
    "build:packages": "cd ../.. && nx run-many --target=build --projects=db-outbox --parallel=false",
    "firebase:emulator:start": "docker compose -f ../../docker-compose.firebase-emulator.yml up -d",
    "firebase:emulator:stop": "docker compose -f ../../docker-compose.firebase-emulator.yml down",
    "firebase:emulator:restart": "docker compose -f ../../docker-compose.firebase-emulator.yml restart firebase-auth",
    "firebase:emulator:logs": "docker compose -f ../../docker-compose.firebase-emulator.yml logs -f firebase-auth",
    "firebase:emulator:status": "docker compose -f ../../docker-compose.firebase-emulator.yml ps firebase-auth",
    "test:firebase:emulator": "FIREBASE_AUTH_EMULATOR_HOST=localhost:9099 jest src",
    "test:e2e:firebase:emulator": "FIREBASE_AUTH_EMULATOR_HOST=localhost:9099 pnpm test:e2e"
  },
  "dependencies": {
    "@nest-lab/throttler-storage-redis": "^1.1.0",
    "@nestjs/config": "^12.0.0",
    "@nestjs/mapped-types": "12.0.0",
    "@nestjs/schedule": "^12.0.1",
    "@nestjs/swagger": "^12.0.1",
    "@nestjs/throttler": "^6.5.0",
    "@package/auth": "workspace:*",
    "@package/constants": "workspace:*",
    "@package/core": "workspace:*",
    "@package/db-outbox": "workspace:*",
    "@package/db-core": "workspace:*",
    "@package/email": "workspace:*",
    "@package/encryption": "workspace:*",
    "@package/errors": "workspace:*",
    "@package/events": "workspace:*",
    "@package/observability": "workspace:*",
    "@package/opa": "workspace:*",
    "@package/queues": "workspace:*",
    "@package/redis": "workspace:*",
    "@package/storage": "workspace:*",
    "@package/test-utils": "workspace:*",
    "@package/types": "workspace:*",
    "@package/utils": "workspace:*",
    "bullmq": "^5.66.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "ioredis": "^5.4.1"
  },
  "devDependencies": {
    "@jest/globals": "^30.0.2",
    "p-limit": "^7.3.0",
    "svix": "^1.84.1"
  }
}
