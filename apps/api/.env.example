# API Configuration
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
API_PREFIX=api
SERVICE_NAME=api-local

# Debug Mode
# Enable debug logging for auth providers (default: false)
DEBUG=false

# Test Mode
# Enable test mode for auth providers (bypasses some validations, default: false)
# Only set to true for testing purposes
TEST_MODE=false

# API Versioning
# ==============
#
# Format: prefix:version:status:sunsetDate
# - prefix: Version URL prefix (e.g., v1, v2)
# - version: Semantic version (e.g., 1.0.0, 2.0.0)
# - status: active, deprecated, or sunset
# - sunsetDate: (optional) ISO date when deprecated version will be removed
#
# Examples:
#   Single active version:
#   API_VERSIONS=v1:1.0.0:active
#
#   Multiple active versions:
#   API_VERSIONS=v1:1.0.0:active,v2:2.0.0:active
#
#   With deprecated version:
#   API_VERSIONS=v1:1.0.0:deprecated:2026-06-30,v2:2.0.0:active
API_VERSIONS=v1:1.0.0:active
API_DEFAULT_VERSION=v1
API_DEPRECATION_WARNING_DAYS=365

# API Versioning Controls
API_VERSIONING_ENABLED=true

# API Versioning Limits (optional)
# Maximum number of API versions allowed (default: 100)
# API_MAX_VERSIONS=100
# Maximum length of API_VERSIONS string in characters (default: 500)
# API_MAX_VERSION_SPEC_LENGTH=500

# Version Guard Strict Mode (optional)
# When enabled, endpoints without @ApiVersion() decorator will throw an error
# instead of allowing access with a warning
# VERSION_GUARD_STRICT_MODE=false

# Git Information (set during build, optional)
# GIT_COMMIT=<full git hash>
# GIT_SHORT_COMMIT=<short 7-char git hash>

# Swagger Documentation
SWAGGER_ENABLED=true
SWAGGER_PATH=api/docs
SWAGGER_TITLE=Platform Service REST API
SWAGGER_DESCRIPTION=Interactive OpenAPI specification and developer reference for Platform Services
SWAGGER_VERSION=1.0.0
SWAGGER_TAG=Core Platform

# CORS
CORS_ENABLED=true
# CORS_ORIGIN supports:
#   - Wildcard: * (allows all origins)
#   - Single origin: http://localhost:3000
#   - Multiple origins (comma-separated): http://localhost:3000,http://localhost:3001,https://example.com
CORS_ORIGIN=*

# Web app public URL (used for links in transactional emails)
WEBAPP_PUBLIC_URL=http://localhost:3001
# Optional override specifically for invitation email links
INVITATION_WEBAPP_URL=
# Optional override specifically for password-reset links
PASSWORD_RESET_WEBAPP_URL=

# Email Provider Configuration
# ============================
#
# Outbound provider selection for transactional email and inbound webhook verification.
# Set EMAIL_PROVIDER=resend and configure both secrets when using Resend.
EMAIL_PROVIDER=mock
# Required when EMAIL_PROVIDER=resend for outbound sends
RESEND_API_KEY=
# Required for validating inbound POST /api/v1/webhooks/email/resend signatures
RESEND_WEBHOOK_SECRET=

# I18n (Internationalization)
# ===========================
#
# Default language for translations when no locale is specified
API_DEFAULT_LANGUAGE=en
# Available languages (comma-separated list of locale codes)
# Supported locales: en, ar-SA
API_AVAILABLE_LANGUAGES=en,ar-SA
# Maximum number of allowed locales (default: 100)
# API_MAX_LOCALES=100

# Redis Configuration
# ===================
#
# Redis connection settings for caching and pub/sub
#
# Enable/disable Redis module (default: false)
# Set to true to enable Redis functionality (caching, pub/sub, etc.)
REDIS_ENABLED=false
#
# Connection URL (preferred method)
# Format: redis://[username:password@]host:port/[db]
#         rediss://[username:password@]host:port/[db]  (for SSL/TLS)
# Example: redis://localhost:6379/0
# Example: redis://:mypassword@redis.example.com:6379/1
# Example: rediss://:mypassword@secure-redis.example.com:6380/0
REDIS_URL=
#
# Individual connection settings (alternative to REDIS_URL)
# Redis server host (default: localhost)
REDIS_HOST=localhost
# Redis server port (default: 6379)
REDIS_PORT=6379
# Redis username for ACL authentication (optional, Redis 6+)
REDIS_USER=
# Redis password (optional, leave empty for no authentication)
REDIS_PASSWORD=
# Redis database number (0-15, default: 0)
REDIS_DB=0
# Enable graceful shutdown on SIGTERM/SIGINT (default: true)
REDIS_GRACEFUL_SHUTDOWN=true

# Cache Configuration
# ===================
#
# Global cache settings with configurable TTL values

# Enable/disable caching globally
CACHE_ENABLED=true
# Default TTL for single entity cache (seconds, default: 300 = 5 minutes)
CACHE_ENTITY_TTL=300
# Default TTL for list/query cache (seconds, default: 60 = 1 minute)
CACHE_LIST_TTL=60
# Short TTL for frequently changing data (seconds, default: 15)
CACHE_SHORT_TTL=15
# Long TTL for rarely changing data (seconds, default: 3600 = 1 hour)
CACHE_LONG_TTL=3600
# Extended TTL for static data (seconds, default: 86400 = 24 hours)
CACHE_EXTENDED_TTL=86400

# Observability Configuration
# Enable/disable global OpenTelemetry (tracing, metrics, logging)
# Set to 'true' for local development to use observability stack
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
SERVICE_NAME=api-local
SERVICE_VERSION=1.0.0

# Redis Cache Telemetry
# Enable/disable Redis cache operation telemetry (spans, metrics)
# Requires OTEL_ENABLED=true for global OpenTelemetry to work
REDIS_TELEMETRY_ENABLED=true

# Google Identity Platform Configuration (Primary Authentication)
# ==============================================================
#
# Google Identity Platform / Firebase Auth is used for authentication,
# authorization, and user management.
#
# Firebase Console: https://console.firebase.google.com/
# Documentation: https://cloud.google.com/identity-platform
#
# GCP/Firebase Project ID (required)
FIREBASE_PROJECT_ID=your-project-id
# Firebase API Key for client authentication (required)
# Get from: Project Settings > General > Web API Key
FIREBASE_API_KEY=AIzaSy...
# Firebase Service Account Email (required for admin operations)
# Format: firebase-adminsdk@project-id.iam.gserviceaccount.com
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@project-id.iam.gserviceaccount.com
# Firebase Service Account Private Key (required for admin operations)
# Format: PEM format with \n escaped as \\n in .env files
# Example: "-----BEGIN PRIVATE KEY-----\\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQC...\\n-----END PRIVATE KEY-----\\n"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"
# Firebase Tenant ID (optional, for multi-tenancy)
# Get from: Firebase Console > Authentication > Tenant ID
FIREBASE_TENANT_ID=

# GCP Identity Platform Deletion Batch Configuration
# ================================================
#
# Batch processing configuration for deleting users from GCP Identity Platform.
# This improves performance when deleting large organizations.

# Number of users to delete per batch (default: 10)
# Higher values = faster deletion but more memory usage
# Recommended: 10-50 depending on organization size
# Min: 1, Max: 50
GCP_DELETE_BATCH_SIZE=10

# Maximum number of concurrent deletions within each batch (default: 2)
# Higher values = more parallel deletion but may hit GCP API rate limits
# Recommended: 2-10 to avoid rate limiting while maintaining performance
# Min: 1, Max: 10
GCP_DELETE_CONCURRENCY_LIMIT=2

# ============================================================================
# FIREBASE AUTH EMULATOR (LOCAL DEVELOPMENT)
# ============================================================================
#
# The Firebase Auth Emulator allows local development without:
# - Using production Firebase credentials
# - Incurring Firebase API costs
# - Affecting production user data
# - Requiring internet connectivity
#
# QUICK START:
# 1. Start the emulator:
#    docker-compose -f docker-compose.firebase-emulator.yml up -d
#    OR: pnpm --filter api firebase:emulator:start
#
# 2. Enable emulator by uncommenting FIREBASE_AUTH_EMULATOR_HOST below
#
# 3. Use demo credentials (emulator accepts any values):
#    FIREBASE_PROJECT_ID=demo-local-project
#    FIREBASE_API_KEY=demo-api-key
#
# 4. Start your application:
#    pnpm nx serve api
#
# 5. Stop emulator when done:
#    docker-compose -f docker-compose.firebase-emulator.yml down
#    OR: pnpm --filter api firebase:emulator:stop
#
# DETAILED GUIDE:
# See: docs/local-development/firebase-auth-emulator.md
#
# AVAILABLE SCRIPTS:
# - pnpm --filter api firebase:emulator:start     - Start emulator
# - pnpm --filter api firebase:emulator:stop      - Stop emulator
# - pnpm --filter api firebase:emulator:restart   - Restart emulator
# - pnpm --filter api firebase:emulator:logs      - View emulator logs
# - pnpm --filter api firebase:emulator:status    - Check emulator status
#
# IMPORTANT NOTES:
# - ONLY use FIREBASE_AUTH_EMULATOR_HOST for local development
# - NEVER enable this in production (security risk)
# - The emulator ignores most credential values (uses demo values)
# - Data is stored in-memory by default (lost on restart)
# - The emulator runs on port 9099 by default
#
# ============================================================================
#
# To ENABLE the Firebase Auth Emulator for local development,
# UNCOMMENT the line below:
#
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
#
# To DISABLE (use production Firebase), keep the line commented out.
#
# ============================================================================

# Firebase Project ID
# - For emulator: Use demo-local-project (or any value starting with "demo-")
# - For production: Use your actual Firebase project ID from Firebase Console
FIREBASE_PROJECT_ID=your-project-id

# Firebase API Key
# - For emulator: Use demo-api-key (emulator accepts any value)
# - For production: Use your actual Firebase API Key from Project Settings
FIREBASE_API_KEY=AIzaSy...

# Firebase Service Account Email
# - For emulator: firebase-adminsdk@demo-local-project.iam.gserviceaccount.com
# - For production: firebase-adminsdk@your-project-id.iam.gserviceaccount.com
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@project-id.iam.gserviceaccount.com

# Firebase Service Account Private Key
# - For emulator: Any valid PEM format (emulator doesn't validate)
# - For production: Actual service account private key from Google Cloud Console
# Format: PEM format with \n escaped as \\n in .env files
# Example: "-----BEGIN PRIVATE KEY-----\\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQC...\\n-----END PRIVATE KEY-----\\n"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"

# JWT Configuration
# =================
#
# JWT token validation settings (used by auth package)
# Note: Firebase tokens are signed by Google and validated using Firebase Admin SDK

# JWT secret for application-level tokens (optional, for custom JWT signing)
JWT_SECRET=
# JWT issuer claim (default: Firebase project URL)
# Format: https://securetoken.google.com/{project-id}
JWT_ISSUER=https://securetoken.google.com/your-project-id
# JWT audience claim (default: Firebase project ID)
JWT_AUDIENCE=your-project-id
# Token expiration time in seconds (default: 3600 = 1 hour)
JWT_EXPIRES_IN=3600
# Token algorithm (default: RS256 for Firebase tokens)
JWT_ALGORITHM=RS256

# ============================================================================
# AUTHENTICATION PROVIDER CONFIGURATION
# ============================================================================
#
# Auth Provider Selection
# Options: custom-jwt, google-identity-platform, keycloak
# - custom-jwt: Generate JWT tokens locally using JWT_SECRET (no external dependency)
# - google-identity-platform: Use Firebase/GCP Identity Platform
# - keycloak: Use Keycloak SSO
AUTH_PROVIDER=google-identity-platform

# JWT Configuration (required for custom-jwt provider)
# JWT_SECRET must be at least 32 characters long for security
# Example: JWT_SECRET=your-super-secret-key-at-least-32-characters-long
JWT_SECRET=
# Access token expiration (format: {value}{unit} where unit is h=hours, m=minutes, d=days)
JWT_EXPIRES_IN=1h
# Refresh token expiration in seconds (default: 2592000 = 30 days)
REFRESH_TOKEN_EXPIRES_IN=2592000
# JWT issuer claim (default: https://securetoken.google.com/{project-id})
JWT_ISSUER=https://securetoken.google.com/your-project-id
# JWT audience claim (default: Firebase project ID)
JWT_AUDIENCE=your-project-id
# JWT algorithm (default: RS256 for Firebase, HS256 for custom-jwt)
JWT_ALGORITHM=HS256

# Token Storage Configuration
# ===========================
#
# Redis-based token storage for refresh tokens and blacklisting

# Enable refresh token storage in Redis (default: true)
AUTH_TOKEN_STORAGE_ENABLED=true
# Enable token rotation on refresh (default: true)
AUTH_TOKEN_STORAGE_ROTATION=true
# Enable token blacklisting for access tokens (default: true)
AUTH_TOKEN_STORAGE_BLACKLISTING=true
# Refresh token expiration in seconds (default: 2592000 = 30 days)
AUTH_REFRESH_TOKEN_EXPIRATION=2592000
# Session expiration in seconds (default: 604800 = 7 days)
AUTH_SESSION_EXPIRATION=604800

# Redis Key Prefix Configuration
# ===============================
#
# Customizable Redis key prefixes for token storage

# Key prefix for refresh tokens (default: auth:refresh)
AUTH_REDIS_KEY_PREFIX_REFRESH=auth:refresh
# Key prefix for access token blacklist (default: auth:blacklist:access)
AUTH_REDIS_KEY_PREFIX_BLACKLIST=auth:blacklist:access
# Key prefix for session tokens (default: auth:session)
AUTH_REDIS_KEY_PREFIX_SESSION=auth:session

# Secrets Configuration
# ====================
#
# Secret management integration with GCP Secret Manager, HashiCorp Vault, or 1Password.
# This configuration is provided by the secrets package.
#
# To use secrets providers, import SecretsModule in your app.module.ts:
#   SecretsModule.forRoot({
#     provider: 'gcp', // or 'hashicorp' or 'onepassword'
#   })
#
# Provider Selection
# Which secret provider to use: 'gcp', 'hashicorp', or 'onepassword'
# Default: gcp
SECRET_PROVIDER=gcp

# Google Cloud Platform (GCP) Configuration
# GCP Project ID for Secret Manager and KMS
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# Path to service account credentials JSON file
GOOGLE_APPLICATION_CREDENTIALS=./path/to/credentials.json
# GCP KMS Configuration (for encryption/decryption operations)
# Location of the KMS key ring (matches Terraform config)
# IMPORTANT: Must match GCP_LOCATION_ID in production
KMS_KEY_LOCATION=global
# KMS Key Ring ID where encryption keys are stored
# Production value: app-encryption-keys (from Terraform)
KMS_KEY_RING_ID=app-encryption-keys
# KMS Key ID for encryption/decryption operations
# CRITICAL: Single primary key shared across all tenants
# Production value: primary-encryption-key (from Terraform)
# This replaces the old per-tenant key pattern (tenant-{id})
KMS_KEY_ID=primary-encryption-key

# 1Password Configuration
# 1Password Connect API endpoint (required for 1Password Secrets Automation)
OP_CONNECT_HOST=http://localhost:8080
# 1Password Service Account Token (required for authentication)
OP_SERVICE_ACCOUNT_TOKEN=op_service_account_token
# 1Password Vault ID containing runtime secrets (default: runtime-secrets)
OP_VAULT_ID=runtime-secrets
# 1Password Item name in the vault (default: Runtime Secrets)
OP_ITEM_NAME=Runtime Secrets
# 1Password Field name for KEY=VALUE pairs (default: notes)
OP_FIELD_NAME=notes

# Database Configuration
# =====================
#
# Main database connection URL
# For PostgreSQL with Docker Compose: postgresql://starter:starter_dev@localhost:5432/starter_db
DATABASE_URL="postgresql://starter:starter_dev@localhost:5432/starter_db"

# Events database connection URL (for outbox pattern)
#
# This database stores the outbox table for transactional event publishing.
# It can be the same database as DATABASE_URL or a separate database.
#
# For same database: Use the same value as DATABASE_URL
# For separate database: Use a different database name
#   Example: postgresql://starter:starter_dev@localhost:5432/starter_events_db
#
# Note: If not set, falls back to DATABASE_URL
EVENTS_DATABASE_URL="postgresql://starter:starter_dev@localhost:5432/starter_db"

# Auto-Migration for Events Database
# ===================================
#
# Controls automatic migration execution for the events database (outbox table).
# When enabled (default), migrations run automatically on application startup
# in ALL environments (development, test, production).
#
# Set to 'false' to disable auto-migrations (e.g., in production where migrations
# are run via CI/CD pipelines before deployment).
#
# Default: true (auto-migrations enabled)
# AUTO_MIGRATE_EVENTS=true
#
# To disable auto-migrations:
# AUTO_MIGRATE_EVENTS=false

# Kafka Configuration
# ===================
#
# Kafka is used for event streaming with the outbox pattern.
# This configuration is for local development with Kafka running in Docker.
#
# To start Kafka: docker compose up -d kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=api-local

# Kafka SSL/TLS (optional)
# Enable SSL/TLS for secure connections to Kafka
KAFKA_SSL=false
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# Kafka Connection Timeouts
# Connection timeout in milliseconds (default: 10000)
KAFKA_CONNECTION_TIMEOUT=10000
# Request timeout in milliseconds (default: 30000)
KAFKA_REQUEST_TIMEOUT=30000

# Kafka Retry Configuration
# Retry interval in milliseconds (default: 5000)
KAFKA_RETRY_INTERVAL=5000
# Maximum number of retry attempts (default: 5)
KAFKA_MAX_RETRIES=5

# Kafka Topic Configuration
# Replication factor for internal topics (default: 1)
# For Railway (single broker), use 1. For multi-broker clusters, use 3 or more.
KAFKA_REPLICATION_FACTOR=1

# Kafka Consumer Configuration
# =============================
#
# Consumer session timeout in milliseconds (default: 30000)
# How long a consumer can go without sending a heartbeat
KAFKA_CONSUMER_SESSION_TIMEOUT=30000
# Consumer heartbeat interval in milliseconds (default: 3000)
# How often to send heartbeats to the group coordinator
KAFKA_CONSUMER_HEARTBEAT_INTERVAL=3000
# Append topic suffix to configured consumer group per handler to isolate rebalances
KAFKA_CONSUMER_GROUP_PER_TOPIC=true

# Kafka Producer Configuration
# =============================
#
# Producer acknowledgments (default: 1)
# Number of acknowledgments required from brokers: -1 (all), 0 (none), 1 (leader)
KAFKA_PRODUCER_ACKS=1
# Producer timeout in milliseconds (default: 30000)
# How long to wait for a producer request to complete
KAFKA_PRODUCER_TIMEOUT=30000
# Producer compression codec (default: none)
# Supported values: none, gzip, snappy, lz4, zstd
KAFKA_PRODUCER_COMPRESSION=none

# Outbox Poller Configuration
# ===========================
#
# The outbox pattern ensures transactional event publishing.
# The poller processes outbox records and publishes events to Kafka.
#
# Enable/disable the outbox poller (default: true)
OUTBOX_ENABLED=true
# Poll interval in milliseconds (default: 1000)
OUTBOX_POLL_INTERVAL=1000
# Number of records to process per batch (default: 10)
OUTBOX_BATCH_SIZE=10
# Maximum number of retry attempts for failed events (default: 5)
OUTBOX_MAX_RETRIES=5
# Retry backoff multiplier - exponential backoff (default: 2)
OUTBOX_RETRY_BACKOFF_MULTIPLIER=2
# Initial retry delay in milliseconds (default: 1000)
OUTBOX_INITIAL_RETRY_DELAY=1000
# Cleanup interval in milliseconds - processes soft-deleted records (default: 3600000 = 1 hour)
OUTBOX_CLEANUP_INTERVAL=3600000
# Retention period in days for processed records before cleanup (default: 7)
OUTBOX_RETENTION_DAYS=7

# Events Configuration
# ====================
#
# Graceful shutdown for event processing (default: true)
ENABLE_GRACEFUL_SHUTDOWN=true

# Events Enable/Disable
# Enable/disable events globally (default: true)
EVENTS_ENABLED=true
# Enable event type validation (default: true)
EVENTS_TYPE_VALIDATION_ENABLED=true

# Circuit Breaker Configuration
# Enable circuit breaker for Kafka connections (default: true)
EVENTS_CIRCUIT_BREAKER_ENABLED=true
# Number of failures before opening circuit (default: 5)
EVENTS_CIRCUIT_BREAKER_THRESHOLD=5
# Time in milliseconds before attempting to close circuit (default: 60000)
EVENTS_CIRCUIT_BREAKER_TIMEOUT_MS=60000

# Integration Bridges
# Enable event-to-queues integration (default: false)
INTEGRATION_QUEUES_ENABLED=false
# Enable Kafka-to-PubSub integration (default: false)
INTEGRATION_PUBSUB_ENABLED=false
# Enable event-to-tasks integration (default: false)
INTEGRATION_TASKS_ENABLED=false

# Message handler retry configuration
# Maximum retry attempts for failed event handlers (default: 3)
KAFKA_HANDLER_MAX_RETRIES=3
# Delay between retries in milliseconds (default: 1000)
KAFKA_HANDLER_RETRY_DELAY=1000

# Queues Configuration (BullMQ)
# ===============================
#
# BullMQ is used for background job processing with Redis as the backend.
# These settings configure job retry behavior, worker concurrency, and scheduling.

# Queue Job Configuration
# Default number of job retry attempts before marking as failed (default: 3)
QUEUE_DEFAULT_JOB_ATTEMPTS=3
# Default backoff type for retry strategy: exponential, fixed (default: exponential)
QUEUE_DEFAULT_JOB_BACKOFF_TYPE=exponential
# Default backoff delay in milliseconds between retries (default: 1000)
QUEUE_DEFAULT_JOB_BACKOFF_DELAY=1000
# Number of completed jobs to keep per queue (default: 1000)
QUEUE_REMOVE_ON_COMPLETE_COUNT=1000
# Age in seconds after which to remove completed jobs (default: 604800 = 7 days)
QUEUE_REMOVE_ON_COMPLETE_AGE=604800
# Number of failed jobs to keep per queue (default: 5000)
QUEUE_REMOVE_ON_FAIL_COUNT=5000
# Age in seconds after which to remove failed jobs (default: 2592000 = 30 days)
QUEUE_REMOVE_ON_FAIL_AGE=2592000

# Worker Configuration
# Default number of jobs a worker processes concurrently (default: 1)
# Higher values = more parallelism but higher memory/CPU usage
WORKER_DEFAULT_CONCURRENCY=1
# Stalled job check interval in milliseconds (default: 30000)
WORKER_STALLED_INTERVAL=30000
# Maximum number of stalled jobs allowed (default: 1)
WORKER_MAX_STALLED_COUNT=1

# Scheduler Configuration
# Default timezone for cron jobs (default: UTC)
# Example values: UTC, America/New_York, Europe/London, Asia/Tokyo
SCHEDULER_DEFAULT_TIMEZONE=UTC
# Enable graceful shutdown on SIGTERM/SIGINT (default: true)
# QUEUES_GRACEFUL_SHUTDOWN=true

# ==============================================================================
# Soft Delete Purge Configuration
# ==============================================================================
#
# Automatically purge soft-deleted records after retention period (GDPR compliance)
#
# Soft delete workflow:
# 1. User/org deletion marks records with deletedAt timestamp (data preserved)
# 2. Records kept for SOFT_DELETE_RETENTION_DAYS (default: 90 days)
# 3. Daily job permanently deletes records older than retention period
# 4. Deletion removes from database AND GCP Identity Platform

# Enable/disable automatic purge (default: false for safety)
# Set to 'true' to enable scheduled purge of expired soft-deleted records
SOFT_DELETE_PURGE_ENABLED=true

# Retention period in days for soft-deleted records (default: 90 days)
# After this period, soft-deleted records are permanently deleted
# Recommended: 30-90 days for GDPR compliance, allows account recovery window
SOFT_DELETE_RETENTION_DAYS=30

# Cron schedule for purge job (default: daily at 2am UTC)
# Format: cron pattern (minute hour day month weekday)
# Examples:
#   '0 2 * * *'   - Daily at 2am
#   '0 2 * * 0'   - Weekly on Sunday at 2am
#   '0 2 1 * *'   - Monthly on 1st at 2am
SOFT_DELETE_PURGE_CRON='0 2 * * *'

# Batch size for purge operations (default: 100)
# Number of records to process per batch
SOFT_DELETE_PURGE_BATCH_SIZE=100

# Enable dry-run mode (default: false)
# When true, logs what would be deleted without actually deleting
# Useful for testing before enabling production purge
SOFT_DELETE_PURGE_DRY_RUN=false

# Encryption Configuration
# =======================
#
# Enterprise-grade encryption with support for multiple KMS providers
# Set environment variables based on which KMS provider you're using
#
# IMPORTANT: Only configure the provider(s) you're using. Leave others unset.

# GCP KMS Configuration (Google Cloud Key Management Service)
# ------------------------------------------------------------
# Set these variables if using GCP KMS as your encryption provider
#
# Single-Key Architecture:
# This project uses a SINGLE primary encryption key (primary-encryption-key)
# shared across all tenants. Tenant isolation is maintained via unique Data
# Encryption Keys (DEKs) per vault entry, while the Key Encryption Key (KEK)
# is shared. This architecture provides:
# - Cost efficiency: $1/month vs $1M+/month for 1M tenants
# - Operational simplicity: One key to manage and rotate
# - Security: Tenant isolation via DEKs, not KEKs
#
# Production Configuration (must match Terraform outputs):
# GCP_PROJECT_ID=your-gcp-project-id
# GCP_LOCATION_ID=global
# GCP_KEY_RING_ID=app-encryption-keys
# GCP_KEY_ID=primary-encryption-key
#
# Authentication methods (use one):
# 1. Service account file (for local development):
# GCP_CREDENTIALS_FILE=/path/to/credentials.json
#
# 2. Base64-encoded service account JSON (for CI/CD, Railway, Render, etc.):
#    Encode with: cat service-account-key.json | base64 -w 0
# GCP_CREDENTIALS_BASE64=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50Iiwi...
#
# 3. Application Default Credentials (ADC) for GCP environments:
#    No variables needed - uses GCP metadata server automatically
#
# Optional custom KMS endpoint (for testing/emulators):
# GCP_KMS_ENDPOINT=

# AWS KMS Configuration (Amazon Web Services Key Management Service)
# ------------------------------------------------------------------
# Set these variables if using AWS KMS as your encryption provider
# AWS_REGION=us-east-1
# AWS_KMS_KEY_ID=alias/my-key
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_KMS_ENDPOINT=

# Azure Key Vault Configuration
# ------------------------------
# Set these variables if using Azure Key Vault as your encryption provider
# AZURE_VAULT_URL=https://my-vault.vault.azure.net
# AZURE_KEY_NAME=my-encryption-key
# AZURE_KEY_VERSION=
# AZURE_CREDENTIAL_TYPE=default
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_TENANT_ID=

# Vault Transit Configuration (HashiCorp Vault)
# ----------------------------------------------
# Set these variables if using Vault Transit as your encryption provider
# VAULT_ADDR=http://localhost:8200
# VAULT_TOKEN=s.1234567890abcdef
# VAULT_TRANSIT_ENGINE_PATH=transit
# VAULT_TRANSIT_KEY_NAME=my-transit-key
# VAULT_NAMESPACE=

# Encryption Options
# ------------------
# Global encryption settings that apply to all providers
# ENCRYPTION_ALGORITHM=aes-256-gcm
# ENCRYPTION_ENABLE_DECORATORS=true
# ENCRYPTION_ENABLE_METRICS=true

# Environment Variable Provider (Development Only - NOT for production!)
# -----------------------------------------------------------------------
# Use this provider for local development to store encryption keys directly
# in environment variables. This is NOT secure for production use.
# For production, use GCP KMS with the primary-encryption-key.
#
# IMPORTANT: To use the env-var provider, you must set ENCRYPTION_PROVIDER=env-var
# Otherwise, the module will attempt to auto-detect cloud KMS providers from
# environment variables (GCP_PROJECT_ID, GCP_KEY_RING_ID, etc.)
#
# Local Development Configuration:
# Encryption Provider Selection
# Options: env-var (local dev only), or leave unset for cloud KMS auto-detection
# ENCRYPTION_PROVIDER=env-var
#
# IMPORTANT: Must be hex-encoded 32-byte key (64 hex characters)
# Generate a key: openssl rand -hex 32
# Example: ENCRYPTION_KEY=1d184ca8e107579837f3d2ff9f8ff7fcb061d3e586bd4a41fbac5dbd0b3e19e6
# ENCRYPTION_KEY=your-64-character-hex-key-here
#
# Production Configuration:
# Leave ENCRYPTION_PROVIDER unset (or comment out) to use GCP KMS auto-detection.
# The application will use GCP_PROJECT_ID, GCP_KEY_RING_ID, GCP_KEY_ID, etc.
# to connect to the single primary-encryption-key in GCP KMS.

# Rate Limiting Configuration
# ============================
#
# Rate limiting prevents brute force attacks and protects public endpoints
# from abuse. All limits are per-IP address by default.
#
# Enable/disable rate limiting globally (default: true)
THROTTLE_ENABLED=true

# Login Rate Limiting
# Maximum number of login attempts per time window (default: 5)
THROTTLE_LOGIN_LIMIT=5
# Time window for login attempts in seconds (default: 900 = 15 minutes)
THROTTLE_LOGIN_TTL=900

# Registration Rate Limiting
# Maximum number of registration attempts per time window (default: 3)
THROTTLE_REGISTRATION_LIMIT=3
# Time window for registration attempts in seconds (default: 3600 = 1 hour)
THROTTLE_REGISTRATION_TTL=3600

# Token Refresh Rate Limiting
# Maximum number of token refresh attempts per time window (default: 10)
THROTTLE_REFRESH_TOKEN_LIMIT=10
# Time window for token refresh attempts in seconds (default: 300 = 5 minutes)
THROTTLE_REFRESH_TOKEN_TTL=300

# OAuth Login Rate Limiting
# Maximum number of OAuth login attempts per time window (default: 10)
THROTTLE_OAUTH_LIMIT=10
# Time window for OAuth login attempts in seconds (default: 300 = 5 minutes)
THROTTLE_OAUTH_TTL=300

# Phone Login Rate Limiting
# Maximum number of phone login attempts per time window (default: 5)
THROTTLE_PHONE_LOGIN_LIMIT=5
# Time window for phone login attempts in seconds (default: 900 = 15 minutes)
THROTTLE_PHONE_LOGIN_TTL=900

# Token Validation Rate Limiting
# Maximum number of token validation requests per time window (default: 100)
THROTTLE_VALIDATE_TOKEN_LIMIT=100
# Time window for token validation requests in seconds (default: 60 = 1 minute)
THROTTLE_VALIDATE_TOKEN_TTL=60


# Password Reset Rate Limiting
# Maximum number of password reset requests per time window (default: 3)
THROTTLE_PASSWORD_RESET_LIMIT=3
# Time window for password reset requests in seconds (default: 3600 = 1 hour)
THROTTLE_PASSWORD_RESET_TTL=3600
