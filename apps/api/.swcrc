{
  "$schema": "https://json.schemastore.org/swcrc",
  "jsc": {
    "parser": {
      "syntax": "typescript",
      "decorators": true,
      "dynamicImport": true
    },
    "transform": {
      "legacyDecorator": true,
      "decoratorMetadata": true
    },
    "loose": false,
    "paths": {
      "@/*": ["./*"],
      "@package/*": ["../../packages/*/src"],
      "@package/db-core": ["../../packages/db-core/src"],
      "@package/test-utils": ["../../packages/test-utils/src"]
    },
    "baseUrl": "."
  },
  "module": {
    "type": "commonjs",
    "strictMode": false,
    "noInterop": false
  },
  "sourceMaps": true,
  "exclude": ["node_modules"]
}
