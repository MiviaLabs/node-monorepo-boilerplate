# Events Database Configuration
# ============================
#
# This database stores the outbox table for transactional event publishing.
# It is part of the events package for reliable event delivery.
#
# Connection URL for the events database
#
# Options:
# 1. Same database as main (simplest setup for development)
#    Example: postgresql://starter:starter_dev@localhost:5432/starter_db
#
# 2. Separate database (recommended for production isolation)
#    Example: postgresql://starter:starter_dev@localhost:5432/starter_events_db
#
# Note: Falls back to DATABASE_URL if EVENTS_DATABASE_URL is not set
EVENTS_DATABASE_URL="postgresql://starter:starter_dev@localhost:5432/starter_db"
