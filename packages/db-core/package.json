{
  "name": "@package/db-core",
  "version": "0.0.1",
  "scripts": {
    "seed": "npx tsx src/seed/seed-runner.ts",
    "seed:dev": "ENVIRONMENT=development npx tsx src/seed/seed-runner.ts",
    "seed:test": "ENVIRONMENT=testing npx tsx src/seed/seed-runner.ts",
    "test": "pnpm -C ../.. exec jest --config packages/db-core/jest.config.js",
    "test:unit": "pnpm -C ../.. exec jest --config packages/db-core/jest.config.js --selectProjects unit",
    "test:integration": "pnpm -C ../.. exec jest --config packages/db-core/jest.config.js --selectProjects integration"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "pg": "^8.17.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.0.2",
    "@testcontainers/postgresql": "^10.18.0",
    "jest": "^30.0.2",
    "testcontainers": "^10.18.0"
  }
}
