# ==============================================================================
# queues Configuration
# ==============================================================================
# This file documents all environment variables for configuring the
# queues package (BullMQ job queues).
#
# Configuration Priority:
# 1. User-provided options (highest priority)
# 2. Environment variables (medium priority)
# 3. Default values (lowest priority)

# ==============================================================================
# Redis Configuration
# ==============================================================================
# The queues package uses BullMQ which requires Redis for
# job queue storage. These variables are shared with the redis
# package.

# Redis server host
# Default: localhost
REDIS_HOST=localhost

# Redis server port
# Default: 6379
REDIS_PORT=6379

# Redis username for Redis 6+ ACL authentication (optional)
# Default: (none)
REDIS_USER=

# Redis password (optional)
# Leave empty if Redis doesn't require authentication
# Default: (none)
REDIS_PASSWORD=

# Redis database number
# Note: BullMQ queues will use the same Redis database as specified here
# Default: 0
REDIS_DB=0

# ==============================================================================
# Queue Job Configuration
# ==============================================================================

# Default number of job retry attempts before marking as failed
# Default: 3
QUEUE_DEFAULT_JOB_ATTEMPTS=3

# Default backoff type for retry strategy: exponential, fixed
# Default: exponential
QUEUE_DEFAULT_JOB_BACKOFF_TYPE=exponential

# Default backoff delay in milliseconds between retries
# Default: 1000 (1 second)
QUEUE_DEFAULT_JOB_BACKOFF_DELAY=1000

# Number of completed jobs to keep per queue
# Default: 1000
QUEUE_REMOVE_ON_COMPLETE_COUNT=1000

# Age in seconds after which to remove completed jobs
# Default: 604800 (7 days)
QUEUE_REMOVE_ON_COMPLETE_AGE=604800

# Number of failed jobs to keep per queue
# Default: 5000
QUEUE_REMOVE_ON_FAIL_COUNT=5000

# Age in seconds after which to remove failed jobs
# Default: 2592000 (30 days)
QUEUE_REMOVE_ON_FAIL_AGE=2592000

# ==============================================================================
# Worker Configuration
# ==============================================================================

# Default number of jobs a worker processes concurrently
# Default: 1
# Higher values = more parallelism but higher memory/CPU usage
WORKER_DEFAULT_CONCURRENCY=1

# Stalled job check interval in milliseconds
# Jobs that are processing longer than this interval may be marked as stalled
# Default: 30000 (30 seconds)
WORKER_STALLED_INTERVAL=30000

# Maximum number of stalled jobs allowed
# Default: 1
WORKER_MAX_STALLED_COUNT=1

# ==============================================================================
# Scheduler Configuration
# ==============================================================================

# Default timezone for cron jobs
# Default: UTC
# Example values: UTC, America/New_York, Europe/London, Asia/Tokyo
SCHEDULER_DEFAULT_TIMEZONE=UTC

# ==============================================================================
# Module Options
# ==============================================================================

# Enable graceful shutdown on SIGTERM/SIGINT signals
# When enabled, queues and workers will close gracefully before shutdown
# Default: true
# QUEUES_GRACEFUL_SHUTDOWN=true

# ==============================================================================
# Usage Examples
# ==============================================================================
#
# Example 1: Configure with environment variables
# -----------------------------------------------
# QUEUE_DEFAULT_JOB_ATTEMPTS=5
# QUEUE_DEFAULT_JOB_BACKOFF_DELAY=2000
# WORKER_DEFAULT_CONCURRENCY=10
#
# Example 2: Railway-specific optimizations (smaller storage)
# -----------------------------------------------
# QUEUE_REMOVE_ON_COMPLETE_AGE=172800  # 2 days
# QUEUE_REMOVE_ON_FAIL_AGE=604800      # 7 days
# WORKER_DEFAULT_CONCURRENCY=2         # Limited CPU
#
# Example 3: AWS ECS with more resources
# -----------------------------------------------
# QUEUE_DEFAULT_JOB_ATTEMPTS=5
# WORKER_DEFAULT_CONCURRENCY=10
# WORKER_STALLED_INTERVAL=30000
