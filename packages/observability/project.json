{
  "name": "observability",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/observability/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/observability",
        "main": "packages/observability/src/index.ts",
        "tsConfig": "packages/observability/tsconfig.lib.json",
        "assets": [
          "packages/observability/*.md",
          {
            "input": "packages/observability",
            "glob": "package.json",
            "output": "."
          }
        ]
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsx --test src/**/*.test.ts",
        "cwd": "packages/observability"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint src",
        "cwd": "packages/observability"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit",
        "cwd": "packages/observability"
      }
    }
  },
  "tags": ["scope:shared", "type:observability", "scope:platform"]
}
