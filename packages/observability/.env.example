# ==========================================
# Observability Infrastructure Configuration
# ==========================================
# This package provides logging, metrics, and tracing capabilities
# using OpenTelemetry and Pino.

# ==========================================
# Application Environment
# ==========================================

# Node environment (development, production, test)
# Controls logging format and development-specific features
NODE_ENV=development

# Service name for identification in logs and traces
# Used to distinguish different services in distributed systems
SERVICE_NAME=api

# Service version for telemetry tracking (optional)
# Used to differentiate between versions in observability tools
SERVICE_VERSION=1.0.0

# ==========================================
# Logging Configuration
# ==========================================

# Log level for the logger (debug, info, warn, error, fatal)
# Default: info
# Only logs at or above this level will be output
LOG_LEVEL=info

# ==========================================
# Telemetry Configuration
# ==========================================

# Enable/disable OpenTelemetry tracing and metrics
# Set to 'true' to enable OpenTelemetry
# Default: false
OTEL_ENABLED=false

# OpenTelemetry exporter endpoint (optional)
# If set, telemetry data will be exported to this endpoint
# Example: http://localhost:4318/v1/traces
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
