# ============================================================================
# Events Configuration
# ============================================================================

# Enable/disable events globally
# When set to false, all event publishing is skipped
# Default: true
EVENTS_ENABLED=true

# Enable event type validation
# Validates event type format (e.g., "domain.event")
# Default: true
EVENTS_TYPE_VALIDATION_ENABLED=true

# ============================================================================
# Circuit Breaker Configuration
# ============================================================================

# Enable circuit breaker for Kafka connections
# Prevents cascading failures by blocking requests after threshold failures
# Default: true
EVENTS_CIRCUIT_BREAKER_ENABLED=true

# Number of failures before opening circuit
# Default: 5
EVENTS_CIRCUIT_BREAKER_THRESHOLD=5

# Time in milliseconds before attempting to close circuit (half-open state)
# Default: 60000 (60 seconds)
EVENTS_CIRCUIT_BREAKER_TIMEOUT_MS=60000

# ============================================================================
# Integration Bridges
# ============================================================================

# Enable event-to-queues integration
# Bridges events to job queues via queues package
# Default: false
INTEGRATION_QUEUES_ENABLED=false

# Enable Kafka-to-PubSub integration
# Forwards Kafka events to Google Cloud Pub/Sub via pubsub package
# Default: false
INTEGRATION_PUBSUB_ENABLED=false

# Enable event-to-tasks integration
# Schedules Cloud Tasks based on events via tasks package
# Default: false
INTEGRATION_TASKS_ENABLED=false

# ============================================================================
# Event Routing Configuration
# ============================================================================

# Enable flexible event routing to multiple destinations
# When enabled, events can be routed to Kafka, PubSub, and Queues simultaneously
# Default: false
EVENT_ROUTING_ENABLED=false

# Event routing configuration (JSON format)
# Maps event types to destination arrays
# Supported destinations: kafka, pubsub, queue
# Example: Route user.created to both Kafka and PubSub
# Default: {} (no routing configured)
# EVENT_ROUTING_CONFIG='{"user.created":["kafka","pubsub"],"order.completed":["queue"],"analytics.track":["pubsub"]}'

# Alternative: Path to routing configuration file (JSON format)
# Use this for complex routing configurations
# Default: (none)
# EVENT_ROUTING_CONFIG_PATH=./config/event-routing.json

# ============================================================================
# Outbox Pattern Configuration
# ============================================================================

# Enable outbox pattern for reliable event delivery
# The outbox pattern stores events in the database before publishing
# A background poller then publishes them to Kafka
# Default: true
OUTBOX_ENABLED=true

# Poll interval in milliseconds
# How often the outbox poller checks for new events to publish
# Lower values = faster delivery but higher database load
# Default: 1000 (1 second)
OUTBOX_POLL_INTERVAL=1000

# Batch size for outbox processing
# Number of events to process in each batch
# Higher values = higher throughput but more memory usage
# Default: 10
OUTBOX_BATCH_SIZE=10

# Maximum retry attempts for failed event publishing
# How many times to retry publishing a failed event before giving up
# Default: 5
OUTBOX_MAX_RETRIES=5

# Retry backoff multiplier
# Each retry increases the delay by this multiplier (exponential backoff)
# Default: 2 (doubles the delay each retry: 1s, 2s, 4s, 8s, 16s)
OUTBOX_RETRY_BACKOFF_MULTIPLIER=2

# Initial retry delay in milliseconds
# Starting delay between retry attempts
# Default: 1000 (1 second)
OUTBOX_INITIAL_RETRY_DELAY=1000

# Cleanup interval in milliseconds
# How often to run cleanup of successfully published events
# Default: 3600000 (1 hour)
OUTBOX_CLEANUP_INTERVAL=3600000

# Retention period in days
# How long to keep successfully published events before cleanup
# Default: 7
OUTBOX_RETENTION_DAYS=7

# Connection retry max attempts
# Maximum number of retry attempts when connecting to database
# Default: 3
OUTBOX_CONNECTION_RETRY_MAX=3

# Connection retry delay in milliseconds
# Delay between connection retry attempts
# Default: 2000 (2 seconds)
OUTBOX_CONNECTION_RETRY_DELAY_MS=2000

# ============================================================================
# Kafka Configuration
# ============================================================================

# Comma-separated list of Kafka brokers (bootstrap servers)
# Format: host1:port1,host2:port2,host3:port3
# Default: localhost:9092
KAFKA_BROKERS=localhost:9092

# Unique identifier for the Kafka client
# Used to track the source of requests in Kafka logs
# Default: enterprise-starter-kit
KAFKA_CLIENT_ID=enterprise-starter-kit

# ============================================================================
# Kafka Security: SSL/TLS
# ============================================================================

# Enable SSL/TLS encryption for Kafka connections
# Set to 'true' if your Kafka cluster requires TLS
# Default: false
# KAFKA_SSL=false

# ============================================================================
# Kafka Security: SASL Authentication
# ============================================================================

# SASL mechanism for authentication
# Supported values: plain, scram-sha-256, scram-sha-512, aws
# Only required if your Kafka cluster uses SASL authentication
# Fixed: Now validates SASL credentials
# KAFKA_SASL_MECHANISM=scram-sha-256

# SASL username for authentication
# Required when using SASL mechanisms that need credentials
# KAFKA_SASL_USERNAME=

# SASL password for authentication
# Required when using SASL mechanisms that need credentials
# KAFKA_SASL_PASSWORD=

# ============================================================================
# Advanced Configuration (Optional)
# ============================================================================

# Connection timeout in milliseconds
# How long to wait for a connection to be established
# Default: 10000 (10 seconds)
# KAFKA_CONNECTION_TIMEOUT=10000

# Request timeout in milliseconds
# How long to wait for a response from Kafka
# Default: 30000 (30 seconds)
# KAFKA_REQUEST_TIMEOUT=30000

# Retry interval in milliseconds
# How long to wait between retry attempts
# Default: 5000 (5 seconds)
# KAFKA_RETRY_INTERVAL=5000

# Maximum number of retry attempts
# Default: 5
# KAFKA_MAX_RETRIES=5

# ============================================================================
# Kafka Topic Configuration
# ============================================================================

# Replication factor for automatically created Kafka topics
# - For single-broker clusters (Railway, local dev): Use 1 or leave unset
# - For multi-broker production clusters: Use 3 for high availability
# Default: 1
# KAFKA_REPLICATION_FACTOR=1

# ============================================================================
# Kafka Consumer Configuration
# ============================================================================

# Consumer session timeout in milliseconds
# How long a consumer can go without sending a heartbeat
# Default: 30000 (30 seconds)
# KAFKA_CONSUMER_SESSION_TIMEOUT=30000

# Consumer heartbeat interval in milliseconds
# How often to send heartbeats to the group coordinator
# Default: 3000 (3 seconds)
# KAFKA_CONSUMER_HEARTBEAT_INTERVAL=3000

# ============================================================================
# Kafka Producer Configuration
# ============================================================================

# Producer acknowledgments
# Number of acknowledgments required from brokers: -1 (all), 0 (none), 1 (leader)
# Default: 1
# KAFKA_PRODUCER_ACKS=1

# Producer timeout in milliseconds
# How long to wait for a producer request to complete
# Default: 30000 (30 seconds)
# KAFKA_PRODUCER_TIMEOUT=30000

# Producer compression codec
# Supported values: none, gzip, snappy, lz4, zstd
# Default: none
# KAFKA_PRODUCER_COMPRESSION=none
