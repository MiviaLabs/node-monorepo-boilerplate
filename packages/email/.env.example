# Email Provider Configuration
# Valid values: resend, twilio, sendgrid, mock
EMAIL_PROVIDER=resend

# Resend Configuration (if EMAIL_PROVIDER=resend)
RESEND_API_KEY=your-resend-api-key-here
# Required for verifying inbound Resend webhooks in apps/api
RESEND_WEBHOOK_SECRET=your-resend-webhook-secret-here

# Twilio Configuration (if EMAIL_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_EMAIL_SERVICE_SID=your-twilio-email-service-sid

# Default sender email/name (optional; overrides provider-specific defaults)
DEFAULT_FROM_EMAIL=noreply@yourdomain.com
DEFAULT_FROM_NAME="Your App Name"

# Enable debug logging (optional; defaults to false)
# WARNING: never enable in production - may log non-PII diagnostic info
EMAIL_DEBUG=false

# Web app public URL for invitation/reset links when composed by consuming apps
WEBAPP_PUBLIC_URL=http://localhost:3001
# Optional invitation-link specific override used by API invitation template
INVITATION_WEBAPP_URL=
# Optional password-reset-link specific override used by API auth templates
PASSWORD_RESET_WEBAPP_URL=
