# Infrastructure Core Package Environment Variables
# This package provides core infrastructure utilities including:
# - Graceful shutdown management
# - Retry logic with exponential backoff
# - Health check monitoring
# - OpenTelemetry tracing and metrics

# =============================================================================
# INFRASTRUCTURE CONFIGURATION
# =============================================================================

# Enable graceful shutdown functionality
# When enabled, the application will gracefully shut down on SIGTERM/SIGINT
# Default: true
# INFRA_ENABLE_GRACEFUL_SHUTDOWN=true

# =============================================================================
# TIMEOUT CONFIGURATION
# =============================================================================
# Configure timeout values for different operation types

# Default timeout in milliseconds
# Used for general operations that don't have a specific timeout
# Default: 30000 (30 seconds)
# INFRA_TIMEOUT_DEFAULT=30000

# Short timeout in milliseconds
# Used for quick operations like health checks
# Default: 5000 (5 seconds)
# INFRA_TIMEOUT_SHORT=5000

# Medium timeout in milliseconds
# Used for standard operations
# Default: 15000 (15 seconds)
# INFRA_TIMEOUT_MEDIUM=15000

# Long timeout in milliseconds
# Used for long-running operations
# Default: 60000 (60 seconds)
# INFRA_TIMEOUT_LONG=60000

# Very long timeout in milliseconds
# Used for very long-running operations like batch jobs
# Default: 300000 (5 minutes)
# INFRA_TIMEOUT_VERY_LONG=300000

# =============================================================================
# RETRY CONFIGURATION
# =============================================================================
# Configure retry behavior with exponential backoff

# Maximum number of retry attempts
# Default: 3
# INFRA_RETRY_MAX_ATTEMPTS=3

# Initial retry delay in milliseconds
# Default: 1000 (1 second)
# INFRA_RETRY_INITIAL_DELAY_MS=1000

# Maximum retry delay in milliseconds
# Default: 10000 (10 seconds)
# INFRA_RETRY_MAX_DELAY_MS=10000

# Backoff multiplier for exponential backoff
# Each retry increases the delay by this factor
# Default: 2 (doubles the delay each retry)
# INFRA_RETRY_BACKOFF_MULTIPLIER=2

# =============================================================================
# HEALTH CHECK CONFIGURATION
# =============================================================================
# Configure health check monitoring behavior

# Health check interval in milliseconds
# How often to run health checks
# Default: 30000 (30 seconds)
# INFRA_HEALTH_CHECK_INTERVAL_MS=30000

# Health check timeout in milliseconds
# How long to wait before considering a health check failed
# Default: 5000 (5 seconds)
# INFRA_HEALTH_CHECK_TIMEOUT_MS=5000

# Unhealthy threshold
# Number of consecutive failed health checks before marking as unhealthy
# Default: 3
# INFRA_HEALTH_CHECK_UNHEALTHY_THRESHOLD=3

# =============================================================================
# OPENTELEMETRY CONFIGURATION
# =============================================================================
# Configure OpenTelemetry tracing and metrics

# Enable OpenTelemetry tracing
# Default: true
# INFRA_OTEL_TRACING_ENABLED=true

# Enable OpenTelemetry metrics
# Default: true
# INFRA_OTEL_METRICS_ENABLED=true

# OpenTelemetry tracer name
# Default: '@package/core'
# INFRA_OTEL_TRACER_NAME=@package/core

# OpenTelemetry meter name
# Default: '@package/core'
# INFRA_OTEL_METER_NAME=@package/core

# =============================================================================
# SERVICE IDENTIFICATION (OpenTelemetry)
# =============================================================================
# Optional service identification for distributed tracing

# Service name for traces
# If not set, defaults to the package name or application name
# Example: my-api-service
# SERVICE_NAME=

# Service version for traces
# Useful for tracking deployment versions
# Example: 1.0.0
# SERVICE_VERSION=

# =============================================================================
# CUSTOM ENVIRONMENT VARIABLE NAMES
# =============================================================================
#
# If you need to use custom environment variable names, you can configure them
# via the InfrastructureConfig option:
#
# ```typescript
# import { resolveInfrastructureConfig } from '@package/core';
#
# const config = resolveInfrastructureConfig({
#   envVarNames: {
#     enableGracefulShutdown: 'MY_CUSTOM_ENABLE_SHUTDOWN',
#     timeoutDefault: 'MY_CUSTOM_TIMEOUT',
#     // ... etc
#   }
# });
# ```

# =============================================================================
# EXAMPLE VALUES
# =============================================================================
#
# Example timeout values for different environments:
#
# Development (fast failures):
# INFRA_TIMEOUT_DEFAULT=10000
# INFRA_TIMEOUT_SHORT=2000
# INFRA_TIMEOUT_MEDIUM=5000
#
# Production (longer timeouts):
# INFRA_TIMEOUT_DEFAULT=60000
# INFRA_TIMEOUT_SHORT=10000
# INFRA_TIMEOUT_MEDIUM=30000
#
# Example retry configuration for resilient operations:
# INFRA_RETRY_MAX_ATTEMPTS=5
# INFRA_RETRY_INITIAL_DELAY_MS=500
# INFRA_RETRY_MAX_DELAY_MS=30000
# INFRA_RETRY_BACKOFF_MULTIPLIER=2
