# Storage Package Environment Variables
# ================================================
# This package provides S3-compatible object storage with support for
# AWS S3, MinIO, Cloudflare R2, DigitalOcean Spaces, and other
# endpoint-compatible providers.

# ==============================================
# PROVIDER SELECTION
# ==============================================
# Storage provider to use. v1 currently supports only 's3'.
STORAGE_PROVIDER=s3

# Optional multi-storage support.
# Leave blank for single-storage mode.
STORAGE_INSTANCES=
STORAGE_DEFAULT_INSTANCE=default

# ==============================================
# DEFAULT BUCKET RESOLUTION
# ==============================================
# Primary default bucket used when operations omit bucket.
STORAGE_DEFAULT_BUCKET=app-assets

# Optional provider-level bucket fallback when STORAGE_DEFAULT_BUCKET is not set.
STORAGE_S3_BUCKET=

# ==============================================
# S3-COMPATIBLE CONFIGURATION
# ==============================================
# Custom endpoint for S3-compatible systems such as MinIO.
# Leave blank for AWS S3.
STORAGE_S3_ENDPOINT=http://localhost:9000

# Region is required by the package contract even for some S3-compatible systems.
STORAGE_S3_REGION=us-east-1

# Access credentials for the S3-compatible backend.
STORAGE_S3_ACCESS_KEY_ID=minioadmin
STORAGE_S3_SECRET_ACCESS_KEY=minioadmin

# Optional session token for temporary credentials.
STORAGE_S3_SESSION_TOKEN=

# Set to true for MinIO and other path-style deployments.
STORAGE_S3_FORCE_PATH_STYLE=true

# Optional public base URL for callers that need a public object URL base.
STORAGE_S3_PUBLIC_BASE_URL=

# Default signed URL lifetime in seconds.
STORAGE_S3_SIGNED_URL_EXPIRES_IN_SECONDS=900

# ==============================================
# TESTING
# ==============================================
# Enables mock-provider friendly defaults when consuming apps want explicit test mode.
STORAGE_TEST_MODE=false

# ==============================================
# USAGE NOTES
# ==============================================
# For multiple storages, define names in STORAGE_INSTANCES and use prefixed vars:
# - STORAGE_PRIVATE_DEFAULT_BUCKET
# - STORAGE_PRIVATE_S3_REGION
# - STORAGE_PRIVATE_S3_ACCESS_KEY_ID
# - STORAGE_PRIVATE_S3_SECRET_ACCESS_KEY
#
# Example:
# STORAGE_INSTANCES=default,private
# STORAGE_DEFAULT_INSTANCE=default
# STORAGE_PRIVATE_DEFAULT_BUCKET=private-assets
# STORAGE_PRIVATE_S3_REGION=us-east-1
# STORAGE_PRIVATE_S3_ACCESS_KEY_ID=minioadmin
# STORAGE_PRIVATE_S3_SECRET_ACCESS_KEY=minioadmin
#
# Bucket resolution order:
# 1. per-operation input.bucket
# 2. STORAGE_DEFAULT_BUCKET
# 3. STORAGE_S3_BUCKET
#
# For local MinIO:
# - STORAGE_S3_ENDPOINT=http://localhost:9000
# - STORAGE_S3_FORCE_PATH_STYLE=true
# - STORAGE_S3_REGION=us-east-1
#
# For AWS S3:
# - Leave STORAGE_S3_ENDPOINT blank
# - Usually keep STORAGE_S3_FORCE_PATH_STYLE=false
