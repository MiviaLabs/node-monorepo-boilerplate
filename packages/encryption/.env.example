# Infrastructure Encryption Package Environment Variables
# This package provides enterprise-grade encryption with support for multiple KMS providers

# =============================================================================
# GCP KMS Configuration (Google Cloud Key Management Service)
# =============================================================================
# All variables are optional. Set only if using GCP KMS as your provider.
#
# ARCHITECTURE: Single-Key Model
# ===============================
# This project uses ONE primary encryption key (primary-encryption-key) shared
# across all tenants. This design provides:
# - Cost Efficiency: $1/month vs $1M+/month for 1M per-tenant keys
# - Operational Simplicity: Single key to manage, monitor, and rotate
# - Security: Tenant isolation via unique DEKs per vault entry, not KEKs
#
# The KEK (Key Encryption Key = GCP KMS key) only wraps DEKs.
# Each vault entry has a unique DEK (Data Encryption Key).
# Multi-tenancy security is maintained through envelope encryption.

# Google Cloud Project ID (required for GCP KMS)
# The project ID where your KMS keys are stored
# Example: my-project-id
GCP_PROJECT_ID=

# GCP KMS Location ID (required for GCP KMS)
# The region or location where your key ring is stored
# IMPORTANT: Must match Terraform location (typically 'global')
# Examples: global, us-central1, europe-west1
GCP_LOCATION_ID=global

# GCP KMS Key Ring ID (required for GCP KMS)
# The name of the key ring containing your encryption keys
# Production value: app-encryption-keys (from Terraform)
# Example: app-encryption-keys
GCP_KEY_RING_ID=app-encryption-keys

# GCP KMS Key ID (required for GCP KMS)
# The specific cryptographic key to use for encryption/decryption
# CRITICAL: Single primary key for all tenants
# Production value: primary-encryption-key
# This replaces the old per-tenant pattern (tenant-{organizationId})
# Example: primary-encryption-key
GCP_KEY_ID=primary-encryption-key

# GCP Credentials File (optional)
# Path to service account credentials JSON file
# If not set, uses Google Application Default Credentials (ADC)
# Example: /path/to/credentials.json
GCP_CREDENTIALS_FILE=

# GCP KMS Endpoint (optional)
# Custom endpoint for GCP KMS (useful for testing/mock)
# Example: http://localhost:9090
# GCP_KMS_ENDPOINT=

# =============================================================================
# AWS KMS Configuration (Amazon Web Services Key Management Service)
# =============================================================================
# All variables are optional. Set only if using AWS KMS as your provider.

# AWS Region (required for AWS KMS)
# The AWS region where your KMS keys are stored
# Example: us-east-1
AWS_REGION=

# AWS KMS Key ID (optional)
# The KMS key ID or ARN to use for encryption/decryption
# Example: alias/my-key or arn:aws:kms:us-east-1:123456789:key/12345678-1234-1234-1234-123456789012
AWS_KMS_KEY_ID=

# AWS Access Key ID (optional)
# AWS access key for authentication
# If not set, uses default AWS credential chain
# Example: AKIAIOSFODNN7EXAMPLE
AWS_ACCESS_KEY_ID=

# AWS Secret Access Key (optional)
# AWS secret key for authentication
# If not set, uses default AWS credential chain
# Example: wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_SECRET_ACCESS_KEY=

# AWS Session Token (optional)
# AWS session token for temporary credentials
# Required when using temporary credentials (e.g., IAM role)
# Example: AQoDYXdzEJr...
# AWS_SESSION_TOKEN=

# AWS KMS Endpoint (optional)
# Custom endpoint for AWS KMS (useful for testing/mock)
# Example: http://localhost:9090
# AWS_KMS_ENDPOINT=

# =============================================================================
# Azure Key Vault Configuration
# =============================================================================
# All variables are optional. Set only if using Azure Key Vault as your provider.

# Azure Vault URL (required for Azure Key Vault)
# The URL of your Azure Key Vault
# Example: https://my-vault.vault.azure.net
AZURE_VAULT_URL=

# Azure Key Name (optional)
# The name of the key in Key Vault
# Example: my-encryption-key
AZURE_KEY_NAME=

# Azure Key Version (optional)
# The version of the key to use (uses latest if not specified)
# Example: 1234567890abcdef
# AZURE_KEY_VERSION=

# Azure Credential Type (optional)
# Type of Azure credential to use (default, managedIdentity, clientSecret)
# Default: default
# Options: default, managedIdentity, clientSecret
# AZURE_CREDENTIAL_TYPE=default

# Azure Client ID (optional, for clientSecret credential type)
# The client ID for Azure AD authentication
# Example: 12345678-1234-1234-1234-123456789012
AZURE_CLIENT_ID=

# Azure Client Secret (optional, for clientSecret credential type)
# The client secret for Azure AD authentication
# Example: abc123~xyz789
AZURE_CLIENT_SECRET=

# Azure Tenant ID (optional, for clientSecret credential type)
# The tenant ID for Azure AD authentication
# Example: 12345678-1234-1234-1234-123456789012
AZURE_TENANT_ID=

# =============================================================================
# Vault Transit Configuration (HashiCorp Vault)
# =============================================================================
# All variables are optional. Set only if using Vault Transit as your provider.

# Vault Address (required for Vault Transit)
# The URL of your Vault server
# Example: http://localhost:8200 or https://vault.example.com
VAULT_ADDR=

# Vault Token (required for Vault Transit)
# Authentication token for accessing Vault
# Should be treated as a sensitive secret
# Example: s.1234567890abcdef
VAULT_TOKEN=

# Vault Transit Engine Path (optional)
# The path where the Transit secrets engine is mounted
# Default: transit
# VAULT_TRANSIT_ENGINE_PATH=transit

# Vault Transit Key Name (optional)
# The name of the key in the Transit engine
# Example: my-transit-key
VAULT_TRANSIT_KEY_NAME=

# Vault Namespace (optional)
# Enterprise Vault namespace for multi-tenancy
# Only required if using Vault Enterprise with namespaces
# Example: my-namespace
# VAULT_NAMESPACE=

# =============================================================================
# Encryption Options
# =============================================================================
# These variables control encryption behavior across all providers.

# Encryption Algorithm (optional)
# Default encryption algorithm for envelope encryption
# Default: aes-256-gcm
# Options: aes-256-gcm, aes-128-gcm
# ENCRYPTION_ALGORITHM=aes-256-gcm

# Enable Decorators (optional)
# Enable automatic encryption/decryption via @Encrypted decorator
# Default: true
# ENCRYPTION_ENABLE_DECORATORS=true

# Enable Metrics (optional)
# Enable OpenTelemetry metrics collection for encryption operations
# Default: true
# ENCRYPTION_ENABLE_METRICS=true

# =============================================================================
# Authentication Notes
# =============================================================================
#
# For GCP KMS:
# - Authentication is handled via Google Application Default Credentials (ADC)
# - Set GCP_CREDENTIALS_FILE to your service account key path
# - Or use: gcloud auth application-default login (for development)
# - Or use: GOOGLE_APPLICATION_CREDENTIALS environment variable
#
# For AWS KMS:
# - Uses default AWS credential chain if credentials not explicitly provided
# - Supports: IAM roles, environment variables, shared credentials file
# - For development: aws configure
#
# For Azure Key Vault:
# - Default credential type uses DefaultAzureCredential (tries multiple auth methods)
# - Managed identity for Azure resources (recommended for production)
# - Client secret for service principal authentication
# - Environment: AZURE_TENANT_ID, AZURE_CLIENT_ID, AZURE_CLIENT_SECRET
#
# For Vault:
# - VAULT_TOKEN provides direct authentication
# - For production, consider using Vault Agent or Kubernetes auth methods
# - Token should have appropriate policies for transit secrets engine

# =============================================================================
# Custom Environment Variable Names
# =============================================================================
#
# If you need to use custom environment variable names, you can configure them
# via the EncryptionModule's infrastructureConfig option:
#
# ```typescript
# EncryptionModule.forRoot({
#   infrastructureConfig: {
#     envVarNames: {
#       gcpProjectId: 'MY_CUSTOM_GCP_PROJECT_ID',
#       awsRegion: 'MY_CUSTOM_AWS_REGION',
#       // ... etc
#     }
#   }
# })
# ```

# =============================================================================
# Environment Variable Provider (Development/Testing Only)
# =============================================================================
# WARNING: This provider is NOT recommended for production use.
# It stores encryption keys in environment variables, which are accessible to
# all processes in the same container/environment.
#
# Use this provider for:
# - Local development
# - Testing without cloud dependencies
# - CI/CD pipelines with isolated environments
#
# DO NOT use for:
# - Production environments
# - Multi-tenant applications
# - Environments with compliance requirements (SOC 2, PCI DSS, HIPAA)

# Encryption Key (hex-encoded, 64 characters for AES-256-GCM)
# This is the default key used when no key ID is specified
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Example: 1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1a2b
ENCRYPTION_KEY=

# Multiple keys can be set using key ID suffixes:
# ENCRYPTION_KEY_<keyId> for named keys
# Example for a key with ID "secondary":
# ENCRYPTION_KEY_secondary=2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1a2b3c

# =============================================================================
# Generating a Development Encryption Key
# =============================================================================
#
# Run this command to generate a secure hex-encoded key:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Or with the Node.js crypto module in code:
# const { randomBytes } = require('crypto');
# console.log(randomBytes(32).toString('hex'));
