# ==========================================
# Redis Infrastructure Configuration
# ==========================================
# This package provides Redis client, cache, and pub/sub services
# using ioredis with OpenTelemetry integration.

# ==========================================
# Redis Connection Configuration
# ==========================================

# Redis connection URL (alternative to individual REDIS_* variables)
# When set, this takes priority over REDIS_HOST, REDIS_PORT, REDIS_USER, REDIS_PASSWORD, and REDIS_DB
# Supported formats:
#   redis://[username:password@]host:port/db
#   rediss://[username:password@]host:port/db  (TLS/SSL)
# Default: (none - falls back to individual REDIS_* variables)
# REDIS_URL=redis://localhost:6379/0

# Redis server host
# Default: localhost
REDIS_HOST=localhost

# Redis server port
# Default: 6379
REDIS_PORT=6379

# Redis username for Redis 6+ ACL authentication (optional)
# Leave empty if Redis doesn't use ACL
# Default: (none)
REDIS_USER=

# Redis password (optional)
# Leave empty if Redis doesn't require authentication
# Default: (none)
REDIS_PASSWORD=

# Redis database number (0-15)
# Default: 0
REDIS_DB=0

# ==========================================
# Cache Configuration
# ==========================================

# Default TTL for cache entries in seconds
# Used by CacheService when no explicit TTL is provided
# Default: 300 (5 minutes)
REDIS_DEFAULT_TTL=300

# ==========================================
# Test Configuration
# ==========================================

# Enable test mode (uses mock Redis instead of real connection)
# Set to 'true' to enable
# Default: false (unless NODE_ENV=test)
TEST_MODE=false
