{
  "name": "redis",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/redis/src",
  "projectType": "library",
  "tags": ["scope:infra"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/redis",
        "main": "packages/redis/src/index.ts",
        "tsConfig": "packages/redis/tsconfig.lib.json",
        "assets": ["packages/redis/*.md"]
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "TEST_MODE=true npx tsx --test src/**/*.test.ts",
        "cwd": "packages/redis"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint src",
        "cwd": "packages/redis"
      }
    }
  }
}
