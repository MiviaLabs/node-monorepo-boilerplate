# Infrastructure Secrets Package - Environment Variables
# ================================================
# This package provides secret management integration with GCP Secret Manager
# and HashiCorp Vault for secure credential storage and encryption operations.

# ==============================================
# PROVIDER SELECTION
# ==============================================
# Which secret provider to use: 'gcp', 'hashicorp', or 'onepassword'
SECRET_PROVIDER=gcp

# ==============================================
# GOOGLE CLOUD PLATFORM (GCP) CONFIGURATION
# ==============================================
# GCP Project ID for Secret Manager and KMS
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Path to service account credentials JSON file
# Required for authenticating with GCP services
GOOGLE_APPLICATION_CREDENTIALS=./path/to/credentials.json

# GCP KMS Configuration
# Used for encryption/decryption operations
# Location of the KMS key ring (e.g., 'global', 'us-central1')
KMS_KEY_LOCATION=global

# KMS Key Ring ID where encryption keys are stored
KMS_KEY_RING_ID=vault-keys

# KMS Key ID for encryption/decryption operations
KMS_KEY_ID=vault-key

# ==============================================
# HASHICORP VAULT CONFIGURATION
# ==============================================
# Vault server address (default: http://localhost:8200)
VAULT_ADDR=http://localhost:8200

# Vault authentication token (for development/testing only)
VAULT_TOKEN=

# Vault namespace (for Vault Enterprise)
VAULT_NAMESPACE=

# AppRole authentication - Role ID
# Alternative to VAULT_TOKEN for production deployments
VAULT_ROLE_ID=

# AppRole authentication - Secret ID
# Used with VAULT_ROLE_ID for AppRole authentication
VAULT_SECRET_ID=

# ==============================================
# 1PASSWORD CONFIGURATION
# ==============================================
# 1Password Connect API endpoint
# Required for 1Password Secrets Automation
OP_CONNECT_HOST=http://localhost:8080

# 1Password Service Account Token
# Required for authenticating with 1Password Secrets Automation
OP_SERVICE_ACCOUNT_TOKEN=op_service_account_token

# 1Password Vault ID containing runtime secrets
# Default: runtime-secrets
OP_VAULT_ID=runtime-secrets

# 1Password Item name in the vault containing secret values
# Default: Runtime Secrets
OP_ITEM_NAME=Runtime Secrets

# 1Password Field name for text-based format (KEY=VALUE pairs)
# Default: notes
# Used when storing secrets as KEY=VALUE pairs in a single field
# The provider will first look in this field, then search all fields as fallback
OP_FIELD_NAME=notes

# ==============================================
# USAGE NOTES
# ==============================================
# For Development:
# - Use SECRET_PROVIDER=hashicorp with local Vault instance
# - Or use DevSecretProvider which reads from process.env directly
#
# For Production (GCP):
# - Set SECRET_PROVIDER=gcp
# - Provide GOOGLE_CLOUD_PROJECT and GOOGLE_APPLICATION_CREDENTIALS
# - Configure KMS settings for encryption operations
#
# For Production (HashiCorp):
# - Set SECRET_PROVIDER=hashicorp
# - Use VAULT_ROLE_ID and VAULT_SECRET_ID for AppRole auth
# - Never use VAULT_TOKEN in production
#
# For Production (1Password):
# - Set SECRET_PROVIDER=onepassword
# - Provide OP_SERVICE_ACCOUNT_TOKEN for authentication
# - Configure OP_VAULT_ID and OP_ITEM_NAME for secret retrieval
# - Ensure 1Password Connect server is accessible via OP_CONNECT_HOST
