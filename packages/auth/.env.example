# Infrastructure Auth Package Environment Variables
# This package provides authentication providers for various identity systems

# =============================================================================
# GOOGLE IDENTITY PLATFORM / FIREBASE AUTH CONFIGURATION
# =============================================================================

# Firebase Project ID (Required)
# Get from: Firebase Console > Project Settings > General
FIREBASE_PROJECT_ID=your-project-id

# Firebase API Key (Required)
# Get from: Firebase Console > Project Settings > General
FIREBASE_API_KEY=AIzaSy...

# Firebase Client ID (for OAuth flows)
FIREBASE_CLIENT_ID=

# Firebase Client Secret (for OAuth flows)
FIREBASE_CLIENT_SECRET=

# Firebase Tenant ID (Optional - for multi-tenant applications)
# Get from: Firebase Console > Authentication > Tenant management
FIREBASE_TENANT_ID=tenant-abc123

# Google Cloud Project ID (Alternative to FIREBASE_PROJECT_ID)
GOOGLE_CLOUD_PROJECT_ID=your-project-id

# Google Identity Platform Provider Name (Optional)
# Default: 'google-identity-platform'
GOOGLE_IDENTITY_PLATFORM_NAME=google-identity-platform

# Google Identity Platform Timeout in milliseconds (Optional)
# Default: 10000 (10 seconds)
GOOGLE_IDENTITY_PLATFORM_TIMEOUT=10000

# Firebase Auth Emulator Host (Optional - for development)
# Use this for local development with Firebase Emulator
# Format: hostname:port
# Example: localhost:9099
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# =============================================================================
# KEYCLOAK CONFIGURATION
# =============================================================================

# Keycloak Auth Server URL (Required for Keycloak provider)
# Example: https://auth.example.com/realms/myrealm
KEYCLOAK_AUTH_SERVER_URL=

# Keycloak Realm (Required)
KEYCLOAK_REALM=

# Keycloak Client ID (Required)
KEYCLOAK_CLIENT_ID=

# Keycloak Client Secret (Required for confidential clients)
KEYCLOAK_CLIENT_SECRET=

# Keycloak Public Key (Optional - for JWT verification)
# You can provide this directly or use publicKeyUrl
KEYCLOAK_PUBLIC_KEY=

# Keycloak Public Key URL (Optional - fetch from this URL)
KEYCLOAK_PUBLIC_KEY_URL=

# Keycloak Use SSL (Optional)
# Default: true
# KEYCLOAK_USE_SSL=true

# Keycloak Timeout in milliseconds (Optional)
# Default: 5000 (5 seconds)
# KEYCLOAK_TIMEOUT=5000

# Keycloak Admin Username (Optional - for admin operations)
KEYCLOAK_ADMIN_USERNAME=

# Keycloak Admin Password (Optional - for admin operations)
KEYCLOAK_ADMIN_PASSWORD=

# =============================================================================
# GOOGLE OAUTH CONFIGURATION
# =============================================================================

# Google Client ID (Required for Google OAuth)
GOOGLE_CLIENT_ID=

# Google Client Secret (Required for Google OAuth)
GOOGLE_CLIENT_SECRET=

# Google Redirect URI (Required)
# The callback URL after OAuth authentication
GOOGLE_REDIRECT_URI=

# Google Project ID (Optional)
GOOGLE_PROJECT_ID=

# Google HD (Optional)
# Restrict sign-in to a specific domain
# Example: example.com
GOOGLE_HD=

# Google Tenant ID (Optional)
# For multi-tenant Google Workspace
GOOGLE_TENANT_ID=

# Google Provider Name (Optional)
# Default: 'google'
GOOGLE_NAME=google

# Google Use SSL (Optional)
# Default: true
# GOOGLE_USE_SSL=true

# Google Timeout in milliseconds (Optional)
# Default: 5000 (5 seconds)
GOOGLE_TIMEOUT=5000

# =============================================================================
# JWT CONFIGURATION
# =============================================================================

# JWT Secret for signing tokens (Required)
JWT_SECRET=your-jwt-secret-key-here

# JWT Issuer (Optional)
# Default: https://securetoken.google.com/your-project-id
JWT_ISSUER=https://securetoken.google.com/your-project-id

# JWT Audience (Optional)
# Default: your-project-id
JWT_AUDIENCE=your-project-id

# JWT Expiration Time (Optional)
# Default: 1h
# Examples: 1h, 30m, 7d
JWT_EXPIRES_IN=1h

# JWT Algorithm (Optional)
# Default: RS256
JWT_ALGORITHM=RS256

# =============================================================================
# TOKEN STORAGE CONFIGURATION
# =============================================================================

# Enable token storage (Optional)
# Default: true
AUTH_TOKEN_STORAGE_ENABLED=true

# Enable token rotation (Optional)
# Default: true
AUTH_TOKEN_STORAGE_ROTATION=true

# Enable token blacklisting (Optional)
# Default: true
AUTH_TOKEN_STORAGE_BLACKLISTING=true

# Refresh token expiration (Optional)
# Default: 7d
AUTH_REFRESH_TOKEN_EXPIRATION=7d

# Session expiration (Optional)
# Default: 24h
AUTH_SESSION_EXPIRATION=24h

# =============================================================================
# REDIS KEY PREFIX CONFIGURATION
# =============================================================================

# Redis key prefix for refresh tokens (Optional)
# Default: auth:refresh:
AUTH_REDIS_KEY_PREFIX_REFRESH=auth:refresh:

# Redis key prefix for blacklisted tokens (Optional)
# Default: auth:blacklist:
AUTH_REDIS_KEY_PREFIX_BLACKLIST=auth:blacklist:

# Redis key prefix for sessions (Optional)
# Default: auth:session:
AUTH_REDIS_KEY_PREFIX_SESSION=auth:session:

# =============================================================================
# SERVICE ACCOUNT CONFIGURATION (Firebase Admin SDK)
# =============================================================================

# Service Account Client Email (Optional - for production use)
# Get from: Google Cloud Console > IAM & Admin > Service Accounts
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project-id.iam.gserviceaccount.com

# Service Account Private Key (Optional - for production use)
# Get from: Service Account > Keys > Add Key > Create JSON
# IMPORTANT: Preserve the \n characters for line breaks
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# =============================================================================
# APPLICATION DEFAULT CREDENTIALS (ADC)
# =============================================================================
#
# If using ADC (Application Default Credentials), you don't need to provide
# service account credentials. The provider will automatically use ADC in:
# - Google Cloud Run
# - Google Kubernetes Engine (GKE)
# - Google Compute Engine
# - App Engine
# - Cloud Functions
#
# To use ADC locally:
# 1. Install Google Cloud SDK: gcloud auth application-default login
# 2. Or set GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account-key.json
#
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# =============================================================================
# REDIS CONFIGURATION (for token storage)
# =============================================================================

# Redis Host
REDIS_HOST=localhost

# Redis Port
REDIS_PORT=6379

# Redis Password (Optional)
REDIS_PASSWORD=

# Redis DB (Optional, default: 0)
REDIS_DB=0

# =============================================================================
# MULTI-TENANT CONFIGURATION (OPTIONAL)
# =============================================================================

# Default Tenant ID
# This tenant will be used if no tenant is specified
DEFAULT_TENANT_ID=default

# Tenant-specific configuration (if you have multiple tenants)
TENANT_A_ID=tenant-abc123
TENANT_A_NAME=Tenant A
TENANT_B_ID=tenant-def456
TENANT_B_NAME=Tenant B

# =============================================================================
# ENCRYPTION CONFIGURATION (if using encryption features)
# =============================================================================
# Note: These environment variables are from the encryption package
# Only set these if you're using encryption features with this auth package

# GCP KMS Configuration
# GCP_PROJECT_ID=your-project-id
# GCP_LOCATION_ID=global
# GCP_KEY_RING_ID=my-keyring
# GCP_KEY_ID=my-encryption-key
# GCP_CREDENTIALS_FILE=/path/to/credentials.json

# AWS KMS Configuration
# AWS_REGION=us-east-1
# AWS_KMS_KEY_ID=alias/my-key

# Azure Key Vault Configuration
# AZURE_VAULT_URL=https://my-vault.vault.azure.net
# AZURE_KEY_NAME=my-encryption-key

# HashiCorp Vault Configuration
# VAULT_ADDR=http://localhost:8200
# VAULT_TOKEN=your-vault-token

# Development Encryption Key (NOT FOR PRODUCTION)
# ENCRYPTION_KEY=1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1a2b

# =============================================================================
# EXAMPLE VALUES
# =============================================================================
#
# Example FIREBASE_PROJECT_ID:
# my-awesome-project-12345
#
# Example FIREBASE_API_KEY:
# AIzaSyDaGmWKa4JsXZ-HjGw7ISLn_3namBGewQe
#
# Example FIREBASE_CLIENT_EMAIL:
# firebase-adminsdk@my-awesome-project-12345.iam.gserviceaccount.com
#
# Example FIREBASE_TENANT_ID:
# tenant-abc123xyz789
#
# Example KEYCLOAK_AUTH_SERVER_URL:
# https://auth.example.com/realms/myrealm
#
# Example JWT_SECRET:
# generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

# =============================================================================
# NOTES
# =============================================================================
#
# 1. Never commit .env files to version control
# 2. Use different configurations for development, staging, and production
# 3. Rotate secrets regularly
# 4. Use strong, unique values for all secrets
# 5. Keep service account keys secure and rotate them periodically
# 6. For production, use secret management services (e.g., Google Secret Manager)
# 7. When using Firebase with multi-tenancy, set FIREBASE_TENANT_ID or DEFAULT_TENANT_ID
