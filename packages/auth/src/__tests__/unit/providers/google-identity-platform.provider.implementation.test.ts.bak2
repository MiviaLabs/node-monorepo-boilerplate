/**
 * Implementation tests for Google Cloud Identity Platform Auth Provider
 *
 * Tests interface compliance and all 11 IAuthProvider methods using mock provider
 */

import { strict as assert } from 'node:assert';
import { describe, it, beforeEach, afterEach } from 'node:test';
import { mockFirebaseAdmin } from '../../../providers/__mocks__/firebase-mock';

import { AuthenticationError, TokenValidationError, UserInfoRetrievalError } from '../../../errors';
import { createMockFirebaseIdentityPlatformProvider } from '../../../providers/__mocks__/firebase-mock';
import { IAuthProvider } from '../../../providers/auth-provider.interface';

describe('GoogleIdentityPlatformAuthProvider - Implementation Tests', () => {
  let provider: IAuthProvider;

  const mockOptions = {
    projectId: 'test-project',
    apiKey: 'test-api-key',
    tenantId: 'test-tenant',
    name: 'test-firebase',
    timeout: 5000,
  };

  it('should implement IAuthProvider interface', () => {
    provider = createMockFirebaseIdentityPlatformProvider(mockOptions);

    // Verify all required methods exist
    assert.strictEqual(typeof provider.authenticate, 'function');
    assert.strictEqual(typeof provider.validateToken, 'function');
    assert.strictEqual(typeof provider.refreshToken, 'function');
    assert.strictEqual(typeof provider.logout, 'function');
    assert.strictEqual(typeof provider.getUserInfo, 'function');
    assert.strictEqual(typeof provider.getUserInfoFromToken, 'function');
    assert.strictEqual(typeof provider.getRoles, 'function');
    assert.strictEqual(typeof provider.getRolesFromToken, 'function');
    assert.strictEqual(typeof provider.getPermissions, 'function');
    assert.strictEqual(typeof provider.getPermissionsFromToken, 'function');
    assert.strictEqual(typeof provider.isAvailable, 'function');
    assert.strictEqual(typeof provider.healthCheck, 'function');
  });

  describe('authenticate (Method 1)', () => {
    beforeEach(() => {
      provider = createMockFirebaseIdentityPlatformProvider(mockOptions);
    });

    it('should authenticate with valid credentials', async () => {
      const result = await provider.authenticate({
        username: 'test@example.com',
        password: 'test-password',
        tenantId: 'test-tenant',
      });

      assert.strictEqual(typeof result.accessToken, 'string');
      assert.strictEqual(typeof result.refreshToken, 'string');
      assert.strictEqual(typeof result.idToken, 'string');
      assert.strictEqual(typeof result.expiresIn, 'number');
      assert.strictEqual(typeof result.refreshExpiresIn, 'number');
    });

    it('should throw AuthenticationError for invalid credentials', async () => {
      await assert.rejects(
        async () => {
          await provider.authenticate({
            username: 'test@example.com',
            password: 'wrong-password',
          });
        },
        (error: Error) => {
          assert.ok(error instanceof AuthenticationError || error instanceof Error);
          return true;
        }
      );
    });

    it('should include tenantId in authentication result if provided', async () => {
      const result = await provider.authenticate({
        username: 'test@example.com',
        password: 'test-password',
        tenantId: 'tenant-123',
      });

      assert.ok(result.accessToken);
    });
  });

  describe('validateToken (Method 2)', () => {
    beforeEach(() => {
      provider = createMockFirebaseIdentityPlatformProvider(mockOptions);
    });

    it('should validate valid token', async () => {
      const mockToken = createMockJwtToken({
        uid: 'test-user-id',
        exp: Math.floor(Date.now() / 1000) + 3600,
      });

      const result = await provider.validateToken(mockToken);

      assert.strictEqual(result.valid, true);
      assert.strictEqual(result.userId, 'test-user-id');
      assert.strictEqual(typeof result.exp, 'number');
    });

    it('should return invalid for expired token', async () => {
      const mockToken = createMockJwtToken({
        uid: 'test-user-id',
        exp: Math.floor(Date.now() / 1000) - 3600, // Expired
      });

      const result = await provider.validateToken(mockToken);

      assert.strictEqual(result.valid, false);
      assert.ok(result.error);
    });

    it('should return invalid for malformed token', async () => {
      const result = await provider.validateToken('invalid-token');

      assert.strictEqual(result.valid, false);
      assert.ok(result.error);
    });
  });

  describe('refreshToken (Method 3)', () => {
    beforeEach(() => {
      provider = createMockFirebaseIdentityPlatformProvider(mockOptions);
    });

    it('should refresh token successfully', async () => {
      const result = await provider.refreshToken('valid-refresh-token');

      assert.strictEqual(typeof result.accessToken, 'string');
      assert.strictEqual(typeof result.refreshToken, 'string');
      assert.strictEqual(typeof result.idToken, 'string');
      assert.strictEqual(typeof result.expiresIn, 'number');
    });

    it('should indicate token rotation', async () => {
      const result = await provider.refreshToken('old-refresh-token');

      assert.strictEqual(result.rotated, true);
    });

    it('should throw TokenValidationError for invalid refresh token', async () => {
      await assert.rejects(
        async () => {
          await provider.refreshToken('invalid-refresh-token');
        },
        (error: Error) => {
          assert.ok(error instanceof TokenValidationError || error instanceof Error);
          return true;
        }
      );
    });
  });

  describe('logout (Method 4)', () => {
    beforeEach(() => {
      provider = createMockFirebaseIdentityPlatformProvider(mockOptions);
    });

    it('should logout successfully', async () => {
      await assert.doesNotReject(provider.logout('valid-refresh-token'));
    });

    it('should logout with access token for blacklisting', async () => {
      await assert.doesNotReject(provider.logout('valid-refresh-token', 'valid-access-token'));
    });

    it('should handle errors gracefully', async () => {
      await assert.doesNotReject(provider.logout('invalid-token'));
    });
  });

  describe('getUserInfo (Method 5)', () => {
    beforeEach(() => {
      provider = createMockFirebaseIdentityPlatformProvider(mockOptions);
    });

    it('should get user info by ID', async () => {
      const userInfo = await provider.getUserInfo('test-user-id', 'test-tenant');

      assert.strictEqual(userInfo.userId, 'test-user-id');
      assert.strictEqual(userInfo.username, 'test@example.com');
      assert.strictEqual(userInfo.email, 'test@example.com');
      assert.strictEqual(userInfo.tenantId, 'test-tenant');
    });

    it('should include roles and permissions', async () => {
      const userInfo = await provider.getUserInfo('test-user-id', 'test-tenant');

      assert.ok(Array.isArray(userInfo.roles));
      assert.ok(Array.isArray(userInfo.permissions));
    });

    it('should throw UserInfoRetrievalError for non-existent user', async () => {
      await assert.rejects(
        async () => {
          await provider.getUserInfo('non-existent-user', 'test-tenant');
        },
        (error: Error) => {
          assert.ok(error instanceof UserInfoRetrievalError || error instanceof Error);
          return true;
        }
      );
    });
  });

  describe('getUserInfoFromToken (Method 6)', () => {
    beforeEach(() => {
      provider = createMockFirebaseIdentityPlatformProvider(mockOptions);
    });

    it('should extract user info from token', async () => {
      const mockToken = createMockJwtToken({
        uid: 'test-user-id',
        email: 'test@example.com',
        given_name: 'Test',
        family_name: 'User',
        name: 'Test User',
        email_verified: true,
        roles: ['user'],
        permissions: ['read:own'],
        tenant_id: 'test-tenant',
      });

      const userInfo = await provider.getUserInfoFromToken(mockToken);

      assert.strictEqual(userInfo.userId, 'test-user-id');
      assert.strictEqual(userInfo.email, 'test@example.com');
      assert.strictEqual(userInfo.givenName, 'Test');
      assert.strictEqual(userInfo.familyName, 'User');
      assert.strictEqual(userInfo.name, 'Test User');
      assert.strictEqual(userInfo.emailVerified, true);
      assert.deepStrictEqual(userInfo.roles, ['user']);
      assert.deepStrictEqual(userInfo.permissions, ['read:own']);
      assert.strictEqual(userInfo.tenantId, 'test-tenant');
    });

    it('should handle token with minimal fields', async () => {
      const mockToken = createMockJwtToken({
        uid: 'test-user-id',
      });

      const userInfo = await provider.getUserInfoFromToken(mockToken);

      assert.strictEqual(userInfo.userId, 'test-user-id');
      assert.strictEqual(userInfo.email, '');
    });
  });

  describe('getRoles (Method 7)', () => {
    beforeEach(() => {
      provider = createMockFirebaseIdentityPlatformProvider(mockOptions);
    });

    it('should get user roles', async () => {
      const roles = await provider.getRoles('test-user-id', 'test-tenant');

      assert.ok(Array.isArray(roles));
      assert.ok(roles.length > 0);
    });

    it('should return empty array if no roles', async () => {
      const roles = await provider.getRoles('user-without-roles', 'test-tenant');

      assert.deepStrictEqual(roles, []);
    });
  });

  describe('getRolesFromToken (Method 8)', () => {
    beforeEach(() => {
      provider = createMockFirebaseIdentityPlatformProvider(mockOptions);
    });

    it('should extract roles from token', async () => {
      const mockToken = createMockJwtToken({
        uid: 'test-user-id',
        roles: ['admin', 'user'],
      });

      const roles = await provider.getRolesFromToken(mockToken);

      assert.deepStrictEqual(roles, ['admin', 'user']);
    });

    it('should return empty array if no roles in token', async () => {
      const mockToken = createMockJwtToken({
        uid: 'test-user-id',
      });

      const roles = await provider.getRolesFromToken(mockToken);

      assert.deepStrictEqual(roles, []);
    });
  });

  describe('getPermissions (Method 9)', () => {
    beforeEach(() => {
      provider = createMockFirebaseIdentityPlatformProvider(mockOptions);
    });

    it('should get user permissions', async () => {
      const permissions = await provider.getPermissions('test-user-id', 'test-tenant');

      assert.ok(Array.isArray(permissions));
    });

    it('should accept userAccessToken parameter', async () => {
      const mockToken = createMockJwtToken({
        uid: 'test-user-id',
        exp: Math.floor(Date.now() / 1000) + 3600,
      });

      const permissions = await provider.getPermissions('test-user-id', 'test-tenant', mockToken);

      assert.ok(Array.isArray(permissions));
    });

    it('should return empty array if no permissions', async () => {
      const permissions = await provider.getPermissions('user-without-permissions', 'test-tenant');

      assert.ok(Array.isArray(permissions));
    });
  });

  describe('getPermissionsFromToken (Method 10)', () => {
    beforeEach(() => {
      provider = createMockFirebaseIdentityPlatformProvider(mockOptions);
    });

    it('should extract permissions from token', async () => {
      const mockToken = createMockJwtToken({
        uid: 'test-user-id',
        permissions: ['read:own', 'write:own'],
      });

      const permissions = await provider.getPermissionsFromToken(mockToken);

      assert.deepStrictEqual(permissions, ['read:own', 'write:own']);
    });

    it('should return empty array if no permissions in token', async () => {
      const mockToken = createMockJwtToken({
        uid: 'test-user-id',
      });

      const permissions = await provider.getPermissionsFromToken(mockToken);

      assert.deepStrictEqual(permissions, []);
    });
  });

  describe('isAvailable (Method 11)', () => {
    beforeEach(() => {
      provider = createMockFirebaseIdentityPlatformProvider(mockOptions);
    });

    it('should return true if provider is available', async () => {
      const available = await provider.isAvailable();

      assert.strictEqual(available, true);
    });

    it('should return false if provider is not available', async () => {
      // Create provider with failure simulation
      const unavailableProvider = createMockFirebaseIdentityPlatformProvider({
        ...mockOptions,
        simulateErrors: true,
      });

      const available = await unavailableProvider.isAvailable();

      assert.strictEqual(available, false);
    });
  });

  describe('healthCheck (Additional Method)', () => {
    beforeEach(() => {
      provider = createMockFirebaseIdentityPlatformProvider(mockOptions);
    });

    it('should return true for healthy provider', async () => {
      const healthy = await provider.healthCheck();

      assert.strictEqual(healthy, true);
    });

    it('should return false for unhealthy provider', async () => {
      // Create provider with failure simulation
      const unhealthyProvider = createMockFirebaseIdentityPlatformProvider({
        ...mockOptions,
        simulateErrors: true,
      });

      const healthy = await unhealthyProvider.healthCheck();

      assert.strictEqual(healthy, false);
    });
  });

  describe('Error Type Compliance', () => {
    beforeEach(() => {
      provider = createMockFirebaseIdentityPlatformProvider(mockOptions);
    });

    it('should throw AuthenticationError for auth failures', async () => {
      await assert.rejects(
        async () => {
          await provider.authenticate({
            username: 'test@example.com',
            password: 'wrong-password',
          });
        },
        (error: Error) => {
          // Should be AuthenticationError or generic Error
          assert.ok(error instanceof Error);
          return true;
        }
      );
    });

    it('should throw TokenValidationError for token validation failures', async () => {
      const result = await provider.validateToken('invalid-token');

      assert.strictEqual(result.valid, false);
      assert.ok(result.error);
    });

    it('should throw UserInfoRetrievalError for user info failures', async () => {
      await assert.rejects(
        async () => {
          await provider.getUserInfo('non-existent-user', 'test-tenant');
        },
        (error: Error) => {
          assert.ok(error instanceof Error);
          return true;
        }
      );
    });
  });

  describe('Factory Integration', () => {
    it('should be creatable via factory', async () => {
      const { AuthProviderFactory } = await import('../../../providers/factory');

      const factory = new AuthProviderFactory();

      // This test verifies that the provider can be registered
      // The actual factory integration is tested separately
      assert.ok(factory);
    });
  });
});

/**
 * Helper function to create a mock JWT token
 */
function createMockJwtToken(payload: Record<string, unknown>): string {
  const header = { alg: 'RS256', typ: 'JWT' };
  const encodedHeader = Buffer.from(JSON.stringify(header)).toString('base64url');
  const encodedPayload = Buffer.from(JSON.stringify(payload)).toString('base64url');
  const signature = 'mock-signature';

  return `${encodedHeader}.${encodedPayload}.${signature}`;
}
