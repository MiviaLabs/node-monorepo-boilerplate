# ============================================================================
# Google Cloud Tasks Configuration
# ============================================================================

# Google Cloud Project ID for Cloud Tasks
# Required: Your Google Cloud project identifier
# Default: (none - must be provided)
CLOUD_TASKS_PROJECT_ID=

# Cloud Tasks location/region
# Required: The region where Cloud Tasks queues are located
# Common values: us-central1, us-east1, europe-west1, asia-northeast1
# Default: (none - must be provided)
CLOUD_TASKS_LOCATION=

# Default queue name for task creation
# Optional: The default queue to use when creating tasks
# Default: (none - can be specified per task)
# CLOUD_TASKS_QUEUE_NAME=default-queue

# ============================================================================
# Authentication Configuration
# ============================================================================

# Path to Google Cloud service account key file (JSON)
# Required for authentication when not using ADC (Application Default Credentials)
# Provide either KEY_FILE or CLIENT_EMAIL + PRIVATE_KEY
# Default: (none)
# CLOUD_TASKS_KEY_FILE=./path/to/service-account-key.json

# Service account email for authentication
# Alternative to KEY_FILE - use with PRIVATE_KEY for explicit credentials
# SECURITY WARNING: Passing private keys via environment variables is not recommended
# Private keys may be exposed in process listings, shell history, or logs
# Default: (none)
# CLOUD_TASKS_CLIENT_EMAIL=

# Service account private key for authentication
# Alternative to KEY_FILE - use with CLIENT_EMAIL for explicit credentials
# Must be in PEM format (-----BEGIN ... PRIVATE KEY-----)
# SECURITY WARNING: Strongly prefer using a keyFile instead
# Default: (none)
# CLOUD_TASKS_PRIVATE_KEY=

# ============================================================================
# Connection Configuration
# ============================================================================

# Request timeout in milliseconds
# How long to wait for Cloud Tasks API operations to complete
# Default: 60000 (60 seconds)
# CLOUD_TASKS_TIMEOUT=60000

# Maximum number of retry attempts for failed API calls
# How many times to retry before giving up
# Default: 3
# CLOUD_TASKS_MAX_RETRIES=3

# ============================================================================
# Observability Configuration
# ============================================================================

# Enable OpenTelemetry tracing for Cloud Tasks operations
# When enabled, traces are exported for task creation and management
# Default: true
# CLOUD_TASKS_ENABLE_TRACING=true

# ============================================================================
# Test Configuration
# ============================================================================

# Enable test mode for local development
# When true, uses mock Cloud Tasks provider
# Default: false (unless NODE_ENV=test)
TEST_MODE=false
