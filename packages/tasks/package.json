{
  "name": "@package/tasks",
  "version": "0.0.1",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "test": "TEST_MODE=true npx tsx --test src/**/*.test.ts",
    "test:unit": "TEST_MODE=true npx tsx --test src/**/*.unit.test.ts",
    "test:integration": "INCLUDE_INTEGRATION_TESTS=1 npx tsx --test src/**/*.integration.test.ts",
    "test:watch": "TEST_WATCH=true npx tsx watch --test src/**/*.test.ts"
  },
  "dependencies": {
    "@google-cloud/tasks": "^5.1.0",
    "@opentelemetry/api": "^1.9.1",
    "@package/core": "workspace:*",
    "@package/observability": "workspace:*",
    "tslib": "^2.3.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.0.0",
    "@opentelemetry/api": "^1.9.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    }
  }
}
