# ============================================================================
# PubSub Configuration
# ============================================================================

# Google Cloud Project ID for Pub/Sub
# Required: Your Google Cloud project identifier
# Default: (none - must be provided)
PUBSUB_PROJECT_ID=

# Pub/Sub topic name for publishing messages
# The topic where messages will be published
# Default: "default-topic"
# PUBSUB_TOPIC_NAME=default-topic

# Pub/Sub subscription name for consuming messages
# The subscription from which messages will be pulled
# Default: "default-subscription"
# PUBSUB_SUBSCRIPTION_NAME=default-subscription

# ============================================================================
# Authentication Configuration
# ============================================================================

# Path to Google Cloud service account key file (JSON)
# Required for authentication when not using ADC (Application Default Credentials)
# Provide either KEY_FILE or CLIENT_EMAIL + PRIVATE_KEY
# Default: (none)
# PUBSUB_KEY_FILE=./path/to/service-account-key.json

# Service account email for authentication
# Alternative to KEY_FILE - use with PRIVATE_KEY for explicit credentials
# Default: (none)
# PUBSUB_CLIENT_EMAIL=

# Service account private key for authentication
# Alternative to KEY_FILE - use with CLIENT_EMAIL for explicit credentials
# Default: (none)
# PUBSUB_PRIVATE_KEY=

# ============================================================================
# Connection Configuration
# ============================================================================

# Request timeout in milliseconds
# How long to wait for Pub/Sub operations to complete
# Default: 30000 (30 seconds)
# PUBSUB_TIMEOUT=30000

# Maximum number of retry attempts for failed operations
# How many times to retry before giving up
# Default: 3
# PUBSUB_MAX_RETRIES=3

# ============================================================================
# Observability Configuration
# ============================================================================

# Enable OpenTelemetry tracing for Pub/Sub operations
# When enabled, traces are exported for publish/subscribe operations
# Default: false
# PUBSUB_ENABLE_TRACING=false

# ============================================================================
# Test Configuration
# ============================================================================

# Enable test mode for local development
# When true, uses emulator or mock Pub/Sub client
# Default: false
# PUBSUB_TEST_MODE=false

# ============================================================================
# Subscriber Configuration
# ============================================================================

# Acknowledgement deadline in seconds
# How long to wait for message acknowledgment before redelivery
# Default: 60 (1 minute)
# PUBSUB_ACK_DEADLINE=60

# Maximum number of messages to pull in each batch
# Higher values = higher throughput but more memory usage
# Default: 10
# PUBSUB_MAX_MESSAGES=10
